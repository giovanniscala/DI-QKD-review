Cell[CellGroupData[{

Cell["Asymptotic rate", "Subsubsection",
 CellChangeTimes->{{3.961568405390379*^9, 
  3.9615684146586304`*^9}},ExpressionUUID->"8db97801-a44b-4a39-bb29-\
f955c1930a61"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"h", "[", "x_", "]"}], " ", ":=", " ", 
  RowBox[{"Piecewise", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "x"}], " ", 
         RowBox[{"Log2", "[", "x", "]"}]}], " ", "-", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "x"}], ")"}], " ", 
         RowBox[{"Log2", "[", 
          RowBox[{"1", " ", "-", " ", "x"}], "]"}]}]}], ",", " ", 
       RowBox[{"0", " ", "<", " ", "x", " ", "<", " ", "1"}]}], "}"}], "}"}], 
    ",", " ", "0"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ra", "[", 
   RowBox[{"\[Eta]_", ",", "\[Alpha]_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"bYE", "[", 
    RowBox[{"1.000001", ",", "\[Eta]", ",", "\[Alpha]"}], "]"}], "-", 
   RowBox[{"h", "[", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     RowBox[{"Erfc", "[", 
      RowBox[{
       SqrtBox[
        RowBox[{"2", "\[Eta]"}]], " ", "\[Alpha]"}], "]"}]}], 
    "]"}]}]}]}], "Input",
 CellChangeTimes->{
  3.9615684268137217`*^9, {3.961568533299903*^9, 3.961568604626646*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"615e6918-4869-4195-855d-1327ac179d92"],

