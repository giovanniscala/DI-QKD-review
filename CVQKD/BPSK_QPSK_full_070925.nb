Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "versione"}]}], " ", 
     RowBox[{"elegante", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "PetzElegant", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PetzElegant", "[", 
      RowBox[{"\[Eta]_", ",", "\[Alpha]_", ",", "a_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Kappa]", ",", "r", ",", "\[Gamma]t", ",", "\[Theta]"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Kappa]", "=", 
         RowBox[{"Exp", "[", 
          RowBox[{"2", " ", 
           RowBox[{"\[Alpha]", "^", "2"}], " ", 
           RowBox[{"(", 
            RowBox[{"\[Eta]", "-", "1"}], ")"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"r", "=", 
         RowBox[{"Erf", "[", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"2", " ", "\[Eta]"}], "]"}], " ", "\[Alpha]"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"\[Gamma]t", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Kappa]", "^", 
               RowBox[{"-", "2"}]}], "-", "1"}], ")"}], " ", 
            RowBox[{"r", "^", "2"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Theta]", "=", 
         RowBox[{"ArcTanh", "[", 
          RowBox[{"\[Kappa]", " ", "\[Gamma]t"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"a", "/", 
           RowBox[{"(", 
            RowBox[{"1", "-", "a"}], ")"}]}], ")"}], "*", 
         RowBox[{"Log2", "[", 
          RowBox[{
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"1", "/", "a"}], "-", "2"}], ")"}]}], "*", 
           RowBox[{"Sech", "[", "\[Theta]", "]"}], "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Cosh", "[", 
                 RowBox[{"a", " ", "\[Theta]"}], "]"}], "+", 
                RowBox[{
                 RowBox[{"\[Gamma]t", "^", 
                  RowBox[{"-", "1"}]}], " ", 
                 RowBox[{"Sinh", "[", 
                  RowBox[{"a", " ", "\[Theta]"}], "]"}]}]}], ")"}], "^", 
              RowBox[{"(", 
               RowBox[{"1", "/", "a"}], ")"}]}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Cosh", "[", 
                 RowBox[{"a", " ", "\[Theta]"}], "]"}], "-", 
                RowBox[{
                 RowBox[{"\[Gamma]t", "^", 
                  RowBox[{"-", "1"}]}], " ", 
                 RowBox[{"Sinh", "[", 
                  RowBox[{"a", " ", "\[Theta]"}], "]"}]}]}], ")"}], "^", 
              RowBox[{"(", 
               RowBox[{"1", "/", "a"}], ")"}]}]}], ")"}]}], "]"}]}]}]}], 
      "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.966224532194811*^9, 3.9662245509610357`*^9}, {
