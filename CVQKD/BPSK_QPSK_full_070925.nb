        RowBox[{"{", 
         RowBox[{"\[Eta]", ",", "_Real"}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t", ",", "e", ",", "e2", ",", 
          RowBox[{"ns", "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0.", ",", "4"}], "]"}]}], ",", "s"}], "}"}], ",", 
        RowBox[{
         RowBox[{"t", "=", 
          RowBox[{
           RowBox[{"\[Alpha]", "^", "2"}], " ", 
           RowBox[{"(", 
            RowBox[{"1", "-", "\[Eta]"}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"e", "=", 
          RowBox[{"Exp", "[", 
           RowBox[{"-", "t"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"e2", "=", 
          RowBox[{"e", "*", "e"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"s", "=", "0"}], ",", 
           RowBox[{"s", "<=", "3"}], ",", 
           RowBox[{"s", "++"}], ",", 
           RowBox[{
            RowBox[{"ns", "[", 
             RowBox[{"[", 
