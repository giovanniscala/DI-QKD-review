Cell[BoxData[{
 RowBox[{
  RowBox[{"Func2", "[", 
   RowBox[{"\[Eta]_", ",", "\[Alpha]_", ",", "a_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["2", 
           RowBox[{"-", "a"}]], " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", "4"}], " ", 
               SuperscriptBox["\[Alpha]", "2"], " ", 
               RowBox[{"(", 
                RowBox[{"1", "-", "\[Eta]"}], ")"}]}]], " ", 
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["\[ExponentialE]", 
                RowBox[{"4", " ", 
                 SuperscriptBox["\[Alpha]", "2"], " ", 
                 RowBox[{"(", 
                  RowBox[{"1", "-", "\[Eta]"}], ")"}]}]], "-", 
               RowBox[{"\[Sqrt]", 
                RowBox[{"(", 
                 RowBox[{
                  SuperscriptBox["\[ExponentialE]", 
                   RowBox[{"4", " ", 
                    SuperscriptBox["\[Alpha]", "2"], " ", 
                    RowBox[{"(", 
                    RowBox[{"1", "-", "\[Eta]"}], ")"}]}]], " ", 
                  RowBox[{"(", 
                   RowBox[{"1", "-", 
                    SuperscriptBox[
                    RowBox[{"Erf", "[", 
                    RowBox[{
                    SqrtBox["2"], " ", "\[Alpha]", " ", 
                    SqrtBox["\[Eta]"]}], "]"}], "2"], "+", 
                    RowBox[{
                    SuperscriptBox["\[ExponentialE]", 
                    RowBox[{"4", " ", 
                    SuperscriptBox["\[Alpha]", "2"], " ", 
                    RowBox[{"(", 
                    RowBox[{"1", "-", "\[Eta]"}], ")"}]}]], " ", 
                    SuperscriptBox[
                    RowBox[{"Erf", "[", 
                    RowBox[{
                    SqrtBox["2"], " ", "\[Alpha]", " ", 
                    SqrtBox["\[Eta]"]}], "]"}], "2"]}]}], ")"}]}], ")"}]}]}], 
              ")"}]}], ")"}], "a"], " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{"2", " ", 
              SuperscriptBox["\[Alpha]", "2"], " ", 
              RowBox[{"(", 
               RowBox[{"1", "-", "\[Eta]"}], ")"}]}]], "+", 
            RowBox[{"\[Sqrt]", 
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["\[ExponentialE]", 
                RowBox[{"4", " ", 
                 SuperscriptBox["\[Alpha]", "2"], " ", 
                 RowBox[{"(", 
                  RowBox[{"1", "-", "\[Eta]"}], ")"}]}]], " ", 
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 SuperscriptBox[
                  RowBox[{"Erf", "[", 
                   RowBox[{
                    SqrtBox["2"], " ", "\[Alpha]", " ", 
                    SqrtBox["\[Eta]"]}], "]"}], "2"], "+", 
                 RowBox[{
                  SuperscriptBox["\[ExponentialE]", 
                   RowBox[{"4", " ", 
                    SuperscriptBox["\[Alpha]", "2"], " ", 
                    RowBox[{"(", 
                    RowBox[{"1", "-", "\[Eta]"}], ")"}]}]], " ", 
                  SuperscriptBox[
                   RowBox[{"Erf", "[", 
                    RowBox[{
                    SqrtBox["2"], " ", "\[Alpha]", " ", 
                    SqrtBox["\[Eta]"]}], "]"}], "2"]}]}], ")"}]}], ")"}]}]}], 
           ")"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"\[Sqrt]", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{"4", " ", 
              SuperscriptBox["\[Alpha]", "2"], " ", 
              RowBox[{"(", 
               RowBox[{"1", "-", "\[Eta]"}], ")"}]}]], " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              SuperscriptBox[
               RowBox[{"Erf", "[", 
                RowBox[{
                 SqrtBox["2"], " ", "\[Alpha]", " ", 
                 SqrtBox["\[Eta]"]}], "]"}], "2"], "+", 
              RowBox[{
               SuperscriptBox["\[ExponentialE]", 
                RowBox[{"4", " ", 
