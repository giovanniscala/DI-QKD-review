Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Section", "::"}], " ", "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"DI", "-", "QKD"}], " ", "\[Dash]", " ", 
    RowBox[{"two", " ", "recent", " ", "analytic", " ", "bounds"}]}], "*)"}], 
  "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"binary", " ", "entropy"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[CurlyPhi]", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "+", " ", "x"}], ")"}], "/", "2"}], ")"}]}], " ", 
       RowBox[{"Log2", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", "x"}], ")"}], "/", "2"}], "]"}]}], " ", 
      "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "x"}], ")"}], "/", "2"}], ")"}], " ", 
       RowBox[{"Log2", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "x"}], ")"}], "/", "2"}], "]"}]}]}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{" ", "1", ")"}], " ", "CHSH"}], "-", 
     RowBox[{
     "only", " ", "bound", " ", "of", " ", "Ac\[IAcute]n", " ", "et", " ", 
      RowBox[{"al", ".", " ", "2006"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gCHSH", "[", "s_", "]"}], " ", ":=", " ", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"\[CurlyPhi]", "[", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"s", "/", "2"}], ")"}], "^", "2"}], " ", "-", " ", "1"}], 
        "]"}], "]"}]}]}], ";", "           ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"H", 
       RowBox[{"(", 
        RowBox[{"A1", "|", "E"}], ")"}], " ", "vs", " ", "CHSH", " ", "S"}], 
      ",", "  ", 
      RowBox[{"q", " ", "=", " ", "0"}]}], " ", "*)"}], "\n", "\n", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{" ", "2", ")"}], " ", "Asymmetric", " ", "CHSH", " ", "bound", 
       " ", "of", " ", "Woodhead", " ", "et", " ", 
       RowBox[{
        RowBox[{"al", "."}], "\n", "   ", "\\", "bar"}], " ", "g_", 
       RowBox[{"{", 
        RowBox[{"q", ",", "\[Alpha]"}], "}"}], 
       RowBox[{"(", "S\[Alpha]", ")"}], " ", "specialised", " ", "to", " ", 
       "the", " ", "convex", " ", "branch"}], " ", "|", "\[Alpha]", "|", 
      RowBox[{"\[GreaterEqual]", "1"}]}], "    ", "*)"}], "\n", 
    RowBox[{
     RowBox[{"gAlpha", "[", 
      RowBox[{"s_", ",", " ", "\[Alpha]_", ",", " ", "q_"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", " ", "=", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"s", "^", "2"}], "/", "4"}], " ", "-", " ", 
           RowBox[{"\[Alpha]", "^", "2"}]}], "]"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"\[CurlyPhi]", "[", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", " ", "-", " ", 
              RowBox[{"2", " ", "q"}]}], ")"}], "^", "2"}], " ", "+", " ", 
           RowBox[{"4", " ", "q", " ", 
            RowBox[{"(", 
             RowBox[{"1", " ", "-", " ", "q"}], ")"}], " ", 
            RowBox[{"x", "^", "2"}]}]}], "]"}], "]"}], " ", "-", " ", 
        RowBox[{"\[CurlyPhi]", "[", "x", "]"}]}]}], "\n", "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{" ", "3", ")"}], " ", "Key"}], "-", 
      RowBox[{"rate", " ", 
       RowBox[{"(", 
        RowBox[{"Devetak", "-", "Winter"}], ")"}], " ", "for", " ", 
       "depolarising", " ", "channel"}]}], ",", " ", 
     RowBox[{
      RowBox[{"visibility", " ", "v"}], "=", 
      RowBox[{"1", "-", 
       RowBox[{"2", "\[Delta]"}]}]}]}], "  ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"h", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "x"}], " ", 
       RowBox[{"Log2", "[", "x", "]"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", "x"}], ")"}], " ", 
       RowBox[{"Log2", "[", 
        RowBox[{"1", " ", "-", " ", "x"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"keyRate", "[", 
      RowBox[{"\[Delta]_", ",", " ", 
       RowBox[{"\[Alpha]_", ":", " ", "1"}], ",", " ", 
       RowBox[{"q_", ":", " ", "0"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"S\[Alpha]", " ", "=", " ", 
          RowBox[{
           RowBox[{"Sqrt", "[", "2", "]"}], " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "+", " ", "\[Alpha]"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"1", " ", "-", " ", 
             RowBox[{"2", " ", "\[Delta]"}]}], ")"}]}]}], ",", "\n", "   ", 
         RowBox[{"\[Delta]q", " ", "=", " ", 
          RowBox[{"q", " ", "+", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", " ", "-", " ", 
              RowBox[{"2", " ", "q"}]}], ")"}], " ", "\[Delta]"}]}]}]}], 
        "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"gAlpha", "[", 
         RowBox[{"S\[Alpha]", ",", " ", "\[Alpha]", ",", " ", "q"}], "]"}], 
        " ", "-", " ", 
        RowBox[{"h", "[", "\[Delta]q", "]"}]}]}], "                     ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"r", " ", "\[GreaterEqual]"}], " ", "..."}], " ", "bits", 
        " ", "per", " ", "channel", " ", "use"}], " ", "*)"}], "\n", "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"::", "Section", "::"}], " ", "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Plots", " ", "mirroring", " ", "the", " ", "main", " ", "figures", " ", 
     "in", " ", "both", " ", "papers"}], "*)"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{" ", "A", ")"}], " ", "Eve"}], "-", 
     RowBox[{"entropy", " ", "bound", " ", "comparison"}]}], " ", "*)"}], 
   "\n", 
   RowBox[{"Plot", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"gCHSH", "[", "s", "]"}], ",", " ", 
       RowBox[{"gAlpha", "[", 
        RowBox[{"s", ",", " ", "0.9", ",", " ", "0"}], "]"}]}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "2", ",", " ", 
       RowBox[{"2", " ", 
        RowBox[{"Sqrt", "[", "2", "]"}]}]}], "}"}], ",", "\n", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<S  (CHSH)\>\"", ",", " ", "\"\<H(A|E)\>\""}], "}"}]}], 
     ",", "\n", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", "\n", "   ", 
       RowBox[{
       "\"\<CHSH bound (\[Alpha] = 1,  q = 0)\>\"", ",", "\n", "   ", 
        "\"\<Asymmetric bound (\[Alpha] = 0.9,  q = 0)\>\""}], "\n", " ", 
       "}"}]}], ",", "\n", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}]}]}], "\n", "]"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{" ", "B", ")"}], " ", "Key"}], "-", 
     RowBox[{"rate", " ", "vs", " ", "depolarising", " ", "error", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"best", " ", "\[Alpha]"}], ",", " ", 
        RowBox[{
         RowBox[{"with", " ", "&"}], " ", 
         RowBox[{"w", "/", "o"}], " ", "preprocessing"}]}], ")"}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"rateNoPre", " ", "=", " ", 
     RowBox[{"Plot", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"Evaluate", "@", 
        RowBox[{"Table", "[", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"keyRate", "[", 
            RowBox[{"\[Delta]", ",", " ", "\[Alpha]", ",", " ", "0"}], "]"}], 
           " ", "/.", " ", "\n", "     ", 
           RowBox[{"\[Alpha]", " ", "->", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "/", 
               RowBox[{"(", 
                RowBox[{"1", " ", "-", " ", 
                 RowBox[{"2", " ", "\[Delta]"}]}], ")"}]}], ")"}], " ", 
             RowBox[{"Max", "[", 
              RowBox[{"1", ",", " ", 
               RowBox[{
                RowBox[{"Sqrt", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", " ", "-", " ", 
                    RowBox[{"2", " ", "\[Delta]"}]}], ")"}], "^", "2"}], "/", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", " ", "-", " ", 
                    RowBox[{"2", " ", "\[Delta]"}]}], ")"}], "^", "2"}]}], 
                 "]"}], " ", "-", " ", "1"}]}], "]"}]}]}]}], ",", " ", "1"}], 
         "]"}]}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"\[Delta]", ",", " ", "0", ",", " ", "0.1"}], "}"}], ",", 
       "\n", "  ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", "Blue", "}"}]}], ",", "\n", "  ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", "\"\<optimal \[Alpha], q=0\>\"", "}"}]}], ",", "\n", 
       "  ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
         "\"\<\[Delta]  (error rate)\>\"", ",", " ", 
          "\"\<r  (bits/round)\>\""}], "}"}]}]}], "\n", "]"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{
    RowBox[{"ratePre", " ", "=", " ", 
     RowBox[{"Plot", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"keyRate", "[", 
        RowBox[{"\[Delta]", ",", " ", "0.84", ",", " ", 
         RowBox[{"1", "/", "2"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Delta]", ",", " ", "0", ",", " ", "0.1"}], "}"}], ",", 
       "\n", "  ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Red", ",", " ", "Dashed"}], "}"}]}], ",", "\n", "  ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{
        "{", "\"\<\[Alpha]\[TildeTilde]0.84,  q\[RightArrow]1/2\>\"", 
         "}"}]}]}], "\n", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"Show", "[", 
    RowBox[{"rateNoPre", ",", " ", "ratePre", ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "]"}], "\n"}]}]], "Code",
