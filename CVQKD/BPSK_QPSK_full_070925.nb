Cell["Definitions", "Subsubsection",
 CellChangeTimes->{{3.962945471959939*^9, 
  3.9629454738272943`*^9}},ExpressionUUID->"0f5264c5-c44b-4508-adef-\
cf585d8bfddd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"normVec", "=", 
    RowBox[{"Compile", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Alpha]", ",", "_Real"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Eta]", ",", "_Real"}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t", ",", "e", ",", "e2", ",", 
          RowBox[{"ns", "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0.", ",", "4"}], "]"}]}], ",", "s"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"t", "=", 
          RowBox[{
           RowBox[{"\[Alpha]", "^", "2"}], " ", 
           RowBox[{"(", 
            RowBox[{"1", "-", "\[Eta]"}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"e", "=", 
          RowBox[{"Exp", "[", 
           RowBox[{"-", "t"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"e2", "=", 
          RowBox[{"e", "*", "e"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"ns", "[", 
             RowBox[{"[", 
              RowBox[{"s", "+", "1"}], "]"}], "]"}], "=", 
            RowBox[{"1.", "/", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"1.", "+", 
               RowBox[{"e2", "*", 
                RowBox[{"Cos", "[", 
                 RowBox[{"Pi", "*", "s"}], "]"}]}], "+", 
               RowBox[{"2.", "*", "e", "*", 
