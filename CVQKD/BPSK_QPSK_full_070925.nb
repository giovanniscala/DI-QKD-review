Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Hvon", "=", 
    RowBox[{"Compile", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"valsYE", ",", "_Complex", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"vecsYE", ",", "_Complex", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"valsE", ",", "_Complex", ",", "1"}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rhoYE", ",", "vYE", ",", "logrhoYE"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"vYE", "=", 
          RowBox[{"Transpose", "[", "vecsYE", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"rhoYE", "=", 
          RowBox[{"vYE", ".", 
           RowBox[{"diag16C", "[", "valsYE", "]"}], ".", 
           RowBox[{"Inverse", "[", "vYE", "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"logrhoYE", "=", 
          RowBox[{"vYE", ".", 
           RowBox[{"diag16C", "[", 
            RowBox[{"Log", "[", "valsYE", "]"}], "]"}], ".", 
           RowBox[{"Inverse", "[", "vYE", "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Tr", "[", 
              RowBox[{"rhoYE", ".", "logrhoYE"}], "]"}]}], "+", 
            RowBox[{"Total", "[", 
             RowBox[{"valsE", " ", 
              RowBox[{"Log", "[", "valsE", "]"}]}], "]"}]}], ")"}], "/", 
          RowBox[{"Log", "[", "2", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"CompilationTarget", "->", "\"\<C\>\""}], ",", 
      RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AEPFast", "[", 
    RowBox[{
     RowBox[{"\[Alpha]_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Eta]_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "rhoE", ",", "rhoYE", ",", "valsYE", ",", "vecsYE", ",", "valsE"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rhoE", "=", 
       RowBox[{"rhoECompiled", "[", 
        RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rhoYE", "=", 
       RowBox[{
        RowBox[{"rhoYECompiledRe", "[", 
         RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}], "+", 
        RowBox[{"I", " ", 
         RowBox[{"rhoYECompiledIm", "[", 
          RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"valsYE", ",", "vecsYE"}], "}"}], "=", 
       RowBox[{"Eigensystem", "[", "rhoYE", "]"}]}], ";", 
