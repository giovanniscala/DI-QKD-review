Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"--", 
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"parameters", " ", "--"}], "--"}], "--"}], "--"}], 
         "--"}]}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"h", "[", "q_", "]"}], "  ", ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "q"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{"2", ",", " ", "q"}], "]"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", "q"}], ")"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{"2", ",", " ", 
         RowBox[{"1", " ", "-", " ", "q"}]}], "]"}]}]}]}], ";", "   ", 
    RowBox[{"(*", " ", 
     RowBox[{"binary", " ", "entropy"}], " ", "*)"}], "\n", "\n", 
    RowBox[{"Qtol", "   ", "=", " ", "0.01"}], ";", "                       ", 
    RowBox[{"(*", " ", 
     RowBox[{"depolarising", " ", "error", " ", "rate"}], "     ", "*)"}], 
    "\n", 
    RowBox[{"etas", "   ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0.45", ",", " ", "1"}], "}"}]}], ";", "                  ", 
    RowBox[{"(*", " ", 
     RowBox[{"plotting", " ", "range", " ", "for", " ", "\[Eta]_tol"}], 
     "     ", "*)"}], "\n", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"asymptotic", " ", "secret"}], "-", "fraction"}], ",", " ", 
      RowBox[{"Eq", ".", " ", 
       RowBox[{"(", "2", ")"}]}]}], " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{"fAsym", "[", 
      RowBox[{"S_", ",", " ", "\[Eta]_"}], "]"}], " ", ":=", " ", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"Log", "[", 
       RowBox[{"2", ",", " ", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"S", "/", 
            RowBox[{"(", 
             RowBox[{"4", " ", "\[Eta]"}], ")"}]}], ")"}], " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"8", " ", "-", " ", 
            RowBox[{"S", "^", "2"}]}], "]"}]}]}]}], "]"}], " ", "-", " ", 
      RowBox[{"2", " ", 
       RowBox[{"h", "[", "Qtol", "]"}]}]}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "visibility", " ", "settings", " ", "used", " ", "in", " ", "the", " ", 
     "paper"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"vis", "     ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0.999", ",", " ", "0.99"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Svals", "   ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"Sqrt", "[", "2", "]"}], " ", "#"}], " ", "&"}], "  ", "/@", 
      " ", "vis"}]}], ";", "     ", 
    RowBox[{"(*", " ", 
     RowBox[{"S", " ", "=", " ", 
      RowBox[{"2", 
       RowBox[{
        RowBox[{"\[Sqrt]", "2"}], "\[CenterDot]", "V"}]}]}], 
     "                  ", "*)"}], "\n", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{"finite", "-", 
      RowBox[{"key", " ", 
       RowBox[{"approximation", ":", " ", 
        RowBox[{
        "parameters", " ", "chosen", " ", "exactly", " ", "as", " ", "in", 
         " ", "caption"}]}]}]}], " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{"fFinite", "[", "\[Eta]_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"S", " ", "=", " ", 
         RowBox[{"2", " ", 
          RowBox[{"Sqrt", "[", "2", "]"}]}]}], "}"}], ",", " ", "\n", "  ", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"Log", "[", 
         RowBox[{"2", ",", " ", 
          RowBox[{"1", " ", "+", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"S", "/", 
              RowBox[{"(", 
               RowBox[{"4", " ", "\[Eta]"}], ")"}]}], ")"}], " ", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"8", " ", "-", " ", 
              RowBox[{"S", "^", "2"}]}], "]"}]}]}]}], "]"}], "         ", 
        RowBox[{"(*", " ", 
         RowBox[{"\[OpenCurlyDoubleQuote]", 
          RowBox[{"log", "-", "term"}], "\[CloseCurlyDoubleQuote]"}], 
         "         ", "*)"}], "\n", "    ", "-", " ", 
        RowBox[{"1.1", " ", 
         RowBox[{"h", "[", "Qtol", "]"}]}], 
        "                                 ", 
        RowBox[{"(*", " ", 
         RowBox[{"EC", " ", "leakage", " ", 
          RowBox[{"(", 
           RowBox[{"1.1", "\[Times]"}], ")"}]}], "  ", "*)"}], "\n", "    ", 
        "-", " ", 
        RowBox[{"h", "[", "Qtol", "]"}]}]}], 
      "                                     ", 
      RowBox[{"(*", " ", 
       RowBox[{"privacy", "-", 
        RowBox[{"amp", " ", "term"}]}], "   ", "*)"}], "\n", "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"plotting", " ", "--"}], "--"}], "--"}], "--"}], 
          "--"}]}]}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"asymCurves", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"fAsym", "[", 
        RowBox[{
         RowBox[{"Svals", "[", 
          RowBox[{"[", "k", "]"}], "]"}], ",", " ", "\[Eta]"}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "1", ",", " ", 
         RowBox[{"Length", "[", "vis", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n",
    "\n", 
   RowBox[{"Plot", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Evaluate", "@", 
      RowBox[{"Join", "[", 
       RowBox[{"asymCurves", ",", " ", 
        RowBox[{"{", 
         RowBox[{"fFinite", "[", "\[Eta]", "]"}], "}"}]}], "]"}]}], ",", "\n",
      "  ", 
     RowBox[{"{", 
      RowBox[{"\[Eta]", ",", " ", 
       RowBox[{"Sequence", " ", "@@", " ", "etas"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", " ", "Thick", ",", " ", "Dashed"}], "}"}]}], ",",
      "\n", "  ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", "\n", "      ", 
       RowBox[{
       "\"\<Asymptotic  V = 0.999\>\"", ",", "\n", "      ", 
        "\"\<Asymptotic  V = 0.99\>\"", ",", "\n", "      ", 
        "\"\<Finite-key (10^8 bits)\>\""}], "\n", "  ", "}"}]}], ",", "\n", 
     "  ", 
     RowBox[{"AxesLabel", "  ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "\"\<\[Eta]_{tol}\>\"", ",", " ", 
        "\"\<\\!\\(\\*SubscriptBox[\\(f\\), \\(secr\\)]\\)\>\""}], "}"}]}], 
     ",", "\n", "  ", 
     RowBox[{"PlotRange", "  ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0.5"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"ImageSize", "  ", "->", " ", "500"}]}], "\n", "]"}], 
   "\n"}]}]], "Code",
