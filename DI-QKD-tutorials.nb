Cell[BoxData[{
 RowBox[{
  RowBox[{"pNL", "[", "d_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    SqrtBox["2"], 
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"2", " ", "d"}]}], ")"}]}], " ", "-", " ", "1"}]}], "\n", 
