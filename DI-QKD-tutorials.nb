   RowBox[{
    RowBox[{"addRoundKey", "[", 
     RowBox[{"block_", ",", "roundKey_"}], "]"}], ":=", 
    RowBox[{"BitXor", "[", 
     RowBox[{"block", ",", "roundKey"}], "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Helper", " ", "function", " ", "to", " ", "convert", " ", "text", " ", 
