Cell[CellGroupData[{

Cell["1. BPSK", "Chapter",
 CellChangeTimes->{{3.9662314004521713`*^9, 
  3.9662314276390977`*^9}},ExpressionUUID->"020d097b-4170-4a5f-86d0-\
b627bbdafd9a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"id", "=", 
   RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a_", "\[CircleDot]", "b_"}], ":=", 
  RowBox[{"KroneckerProduct", "[", 
   RowBox[{"a", ",", "b"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"H", "[", "\[Rho]_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[Lambda]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Lambda]", "=", 
       RowBox[{"Eigenvalues", "[", "\[Rho]", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"-", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", " ", 
           RowBox[{"Log2", "[", "#", "]"}]}], "&"}], "/@", "\[Lambda]"}], 
        "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dd", "[", 
    RowBox[{"\[Rho]_", ",", "\[Sigma]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"log\[Rho]", ",", "log\[Sigma]"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"log\[Rho]", "=", 
       RowBox[{"MatrixLog", "[", "\[Rho]", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"log\[Sigma]", "=", 
       RowBox[{"MatrixLog", "[", "\[Sigma]", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{"\[Rho]", ".", 
         RowBox[{"(", 
          RowBox[{"log\[Rho]", "-", "log\[Sigma]"}], ")"}]}], "]"}], "/", 
       RowBox[{"Log", "[", "2", "]"}]}]}]}], " ", 
    RowBox[{"(*", 
     RowBox[{"convert", " ", "to", " ", "log", " ", "base", " ", "2"}], 
     "*)"}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"yb", "[", "i_", "]"}], ":=", 
  RowBox[{
   RowBox[{"UnitVector", "[", 
    RowBox[{"2", ",", 
     RowBox[{"i", "+", "1"}]}], "]"}], "\[CircleDot]", 
   RowBox[{"UnitVector", "[", 
    RowBox[{"2", ",", 
     RowBox[{"i", "+", "1"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]Ey", "[", 
   RowBox[{"\[Eta]_", ",", "\[Alpha]_", ",", "y_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"cp", ",", "cm"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"cp", "=", 
      RowBox[{"1", "+", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "2"}], 
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Eta]"}], ")"}], 
         SuperscriptBox["\[Alpha]", "2"]}]]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"cm", "=", 
      RowBox[{"1", "-", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "2"}], 
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Eta]"}], ")"}], 
         SuperscriptBox["\[Alpha]", "2"]}]]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", GridBox[{
         {"cp", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "y"], 
           RowBox[{"Erf", "[", 
            RowBox[{
             SqrtBox[
