Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"identico", " ", "al", " ", "codice", " ", "per", " ", "BPSK"}], 
    ",", " ", 
    RowBox[{
    "il", " ", "riferimento", " ", "\[EGrave]", " ", "nel", " ", "file", " ", 
     "overleaf", " ", "Cosmo", " ", "Note"}]}], "*)"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"relative", " ", "divergence"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ddQ", "[", 
     RowBox[{"\[Rho]_", ",", "\[Sigma]_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"log\[Rho]", ",", "log\[Sigma]"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"log\[Rho]", "=", 
        RowBox[{"MatrixLog", "[", "\[Rho]", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"log\[Sigma]", "=", 
        RowBox[{"MatrixLog", "[", "\[Sigma]", "]"}]}], ";", 
       RowBox[{"\[UGrave]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{"\[Rho]", ".", 
           RowBox[{"(", 
            RowBox[{"log\[Rho]", "-", "log\[Sigma]"}], ")"}]}], "]"}], "/", 
         RowBox[{"Log", "[", "2", "]"}]}]}]}]}], " ", 
     RowBox[{"(*", 
      RowBox[{"convert", " ", "to", " ", "log", " ", "base", " ", "2"}], 
      "*)"}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.962015031729331*^9, 3.9620150396639233`*^9}, {
