       ",", "\<\"x\"\>", ",", "\<\"x\"\>", ",", "\<\"\[CheckmarkedBox]\"\>", 
       ",", "\<\"\[CheckmarkedBox]\"\>", ",", "\<\"x\"\>", ",", "\<\"x\"\>", 
       ",", "\<\"\[CheckmarkedBox]\"\>", ",", "\<\"x\"\>", ",", "\<\"x\"\>", 
