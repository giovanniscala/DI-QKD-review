      RowBox[{"\<\"x\"\>", ",", "\<\"x\"\>", ",", "\<\"\[CheckmarkedBox]\"\>",
        ",", "\<\"x\"\>", ",", "\<\"\[CheckmarkedBox]\"\>", ",", "\<\"x\"\>", 
