       RowBox[{"valsYE", ",", "vecsYE", ",", "valsE"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"objFunAEP", "[", 
    RowBox[{
     RowBox[{"\[Alpha]_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Eta]_", "?", "NumericQ"}], ",", 
     RowBox[{"n_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"val", ",", 
       RowBox[{"safe", "=", "True"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"\[Alpha]", "<=", 
         RowBox[{"10", "^", 
          RowBox[{"-", "6"}]}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"-", "penalty"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
       RowBox[{"Check", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"val", "=", 
           RowBox[{
            RowBox[{"AEPFast", "[", 
             RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}], "-", 
            RowBox[{"8", 
             SqrtBox[
              RowBox[{
               RowBox[{"Log2", "[", 
                FractionBox["2", 
                 SuperscriptBox["10", 
                  RowBox[{"-", "8"}]]], "]"}], "/", "n"}]]}], " ", "-", 
            RowBox[{"compiledLeak", "[", 
             RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}]}]}], ";", 
          RowBox[{"(*", 
