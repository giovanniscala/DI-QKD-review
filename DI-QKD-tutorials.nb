Cell[CellGroupData[{

Cell["Ekert 1991 Exercise", "Subsection",
 CellChangeTimes->{{3.9423812016189213`*^9, 3.9423812123664885`*^9}, {
  3.9423829418108487`*^9, 3.94238297540781*^9}, {3.942397171651985*^9, 
  3.9423971753948913`*^9}, {3.9605405411514015`*^9, 
  3.960540547730625*^9}},ExpressionUUID->"8696ce27-4bd6-4b30-9980-\
a31d1e7f035b"],

Cell["\<\
In this section we describe how to obtain the Ekert 91 siftedKey. \
\>", "Text",ExpressionUUID->"53688796-49d0-49bf-b61f-40615f2669b0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SimulateEkert91", "[", "n_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"bases", "=", 
        RowBox[{"{", 
         RowBox[{"\"\<A\>\"", ",", "\"\<B\>\"", ",", "\"\<C\>\""}], "}"}]}], 
       ",", "aliceBasis", ",", "bobBasis", ",", "aliceResult", ",", 
       "bobResult", ",", "keyPairs", ",", "siftedKey"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Initialize", " ", "empty", " ", "lists", " ", "for", " ", "bases", " ",
        "and", " ", "results"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"aliceBasis", "=", 
       RowBox[{"RandomChoice", "[", 
        RowBox[{"bases", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"bobBasis", "=", 
       RowBox[{"RandomChoice", "[", 
        RowBox[{"bases", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"aliceResult", "=", 
       RowBox[{"RandomChoice", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}], ",", "n"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"bobResult", "=", 
       RowBox[{"RandomChoice", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}], ",", "n"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Generate", " ", "entangled", " ", 
         RowBox[{"results", ":", 
          RowBox[{
          "If", " ", "the", " ", "bases", " ", "are", " ", "the", " ", 
           "same"}]}]}], ",", 
        RowBox[{
        "the", " ", "results", " ", "should", " ", "be", " ", "the", " ", 
         "same", " ", 
         RowBox[{"(", 
          RowBox[{"0", " ", "or", " ", "1"}], ")"}], " ", "with", " ", "high",
          " ", "probability"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"aliceBasis", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "===", 
           RowBox[{"bobBasis", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"bobResult", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "=", 
            RowBox[{"aliceResult", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ";"}], " ", 
          RowBox[{"(*", 
           RowBox[{"Perfect", " ", "correlation"}], "*)"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Simulate", " ", "non"}], "-", 
            RowBox[{"correlated", " ", "results"}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"bobResult", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "=", 
            RowBox[{"RandomChoice", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], "]"}]}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Sift", " ", "the", " ", "key"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"keyPairs", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
           "aliceBasis", ",", "bobBasis", ",", "aliceResult", ",", 
            "bobResult"}], "}"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "==", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"siftedKey", "=", 
       RowBox[{"keyPairs", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "4"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Output", " ", "the", " ", "table", " ", "of", " ", "sifted", " ", 
        "keys"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "\"\<AliceBasis\>\"", ",", "\"\<BobBasis\>\"", ",", 
          "\"\<AliceResult\>\"", ",", "\"\<BobResult\>\""}], "}"}], "->", 
        RowBox[{"Transpose", "[", "keyPairs", "]"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Run", " ", "the", " ", "simulation", " ", "for", " ", "n"}], "=",
     "100"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"siftedKeyTable", "=", 
   RowBox[{"SimulateEkert91", "[", "100", "]"}]}], 
  ";"}], "\n", "siftedKeyTable", "\n"}], "Code",
 CellChangeTimes->{
  3.96004116164209*^9, {3.9600419921889963`*^9, 3.9600419943501883`*^9}, {
   3.960042089375121*^9, 3.9600420904532924`*^9}, 3.960087963245934*^9, {
   3.960109712562234*^9, 3.9601097704071307`*^9}, 3.9601103527515965`*^9, {
   3.960309406583851*^9, 3.9603094120226684`*^9}, {3.960309467252062*^9, 
