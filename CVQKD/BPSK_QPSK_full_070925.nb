Cell[CellGroupData[{

Cell[TextData[StyleBox["Rate with AEP",
 FontColor->RGBColor[0, 0, 1]]], "Section",
 CellChangeTimes->{{3.962163924911322*^9, 
  3.96216392778579*^9}},ExpressionUUID->"e369d7c9-156b-45cc-bc97-\
8ebd82714aaa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]", "[", "\[Epsilon]_", "]"}], ":=", 
   RowBox[{"8", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"Log2", "[", 
       FractionBox["2", 
        SuperscriptBox["\[Epsilon]", "2"]], "]"}], ")"}], 
     FractionBox["1", "2"]]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"fattore", " ", "aep", " ", "per", " ", "d"}], "=", "4"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RateAEP", "[", 
   RowBox[{"\[Alpha]_", ",", "\[Eta]_", ",", "n_", ",", "\[Epsilon]_"}], 
   "]"}], ":=", 
  RowBox[{
   RowBox[{"HvonCond", "[", 
    RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}], "-", 
   FractionBox[
    RowBox[{"\[Delta]", "[", "\[Epsilon]", "]"}], 
    SuperscriptBox["n", 
     FractionBox["1", "2"]]], "-", 
   RowBox[{"Leak", "[", 
    RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.962163939560429*^9, 3.9621639456996107`*^9}, {
  3.9621640542604113`*^9, 3.962164072536305*^9}, {3.962164109799658*^9, 
  3.962164249355831*^9}, {3.962164297796516*^9, 3.962164377811558*^9}, {
  3.962170903020648*^9, 3.962170950372279*^9}, {3.962171057627054*^9, 
  3.962171058053797*^9}, {3.96218278039429*^9, 3.962182784329852*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"13c2fd14-69c4-4e3b-95a4-ae9b82f3527f"],

