        RowBox[{"q1", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"q2", ",", "_Real"}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Sigma]", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"0.", "-", 
             RowBox[{"0.", "I"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"\[Rho]", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"0.", "+", 
             RowBox[{"0.", "I"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"\[Lambda]", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.", ",", "4"}], "]"}]}], ",", 
         RowBox[{"tr", "=", "0."}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Sigma]", "=", 
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"q0", "^", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", ".5"}], "+", 
