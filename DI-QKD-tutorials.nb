Cell[TextData[{
 "Generalization 1 and 2 together from the section ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["CHSH", "\[Chi]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a51d875e-d6bf-474c-a353-4218299fbb7b"],
 ". Note that the term ",
 Cell[BoxData[
  RowBox[{"h", "[", 
   FractionBox[
    RowBox[{"1", "+", 
     SqrtBox[
      RowBox[{"1", "-", 
       RowBox[{"q", 
        RowBox[{"(", 
         RowBox[{"1", "-", "q"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"8", "-", 
          SuperscriptBox["\[Beta]1", "2"]}], ")"}]}]}]]}], "2"], "]"}]],
  CellChangeTimes->{3.9608788645220585`*^9},ExpressionUUID->
  "7f8f44f9-0379-47cb-90ec-1526aa7dcc68"],
 " comes from [M. Ho, P. Sekatski, E.Y.-Z. Tan, R. Renner , J.-D. Bancal, N. \
Sangouard, \[OpenCurlyDoubleQuote]Noisy Preprocessing Facilitates a Photonic \
Realization of Device-Independent Quantum Key Distribution\
\[CloseCurlyDoubleQuote], PRL 124, 230502 (2020)] obtained with EAT."
}], "Text",
