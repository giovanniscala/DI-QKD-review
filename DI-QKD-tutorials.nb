   "Effective", " ", "error", " ", "after", " ", "preprocessing", " ", "with",
     " ", "flip", " ", "prob", " ", "q"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eEff", "[", 
