            SuperscriptBox["10", 
             RowBox[{"-", "4"}]]}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"val", "=", 
           RowBox[{"Chop", "@", 
            RowBox[{"Re", "@", "val"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
