Cell[CellGroupData[{

Cell["block-size rate", "Subsubsection",
 CellChangeTimes->{{3.961568405390379*^9, 3.9615684146586304`*^9}, {
  3.9615695038507023`*^9, 
  3.9615695126752415`*^9}},ExpressionUUID->"182791fb-49e3-4e85-99d1-\
32de889d89ad"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"g", "[", "\[Epsilon]_", "]"}], ":=", 
  RowBox[{"Log2", "[", 
   FractionBox["2", 
    SuperscriptBox["\[Epsilon]", "2"]], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"g2", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], "*", 
     RowBox[{"Log2", "[", 
      RowBox[{"1", "/", 
       SuperscriptBox["10", 
        RowBox[{"-", "8"}]]}], "]"}]}], "+", "1"}], "//", 
   "N"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    SuperscriptBox["10", 
     RowBox[{"-", "8"}]], "]"}], "//", "N"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Rate", " ", "con", " ", "Sand", " ", "Up", " ", "ottimizzato"}], 
