      RowBox[{"objFunAEP", "[", 
       RowBox[{"\[Alpha]", ",", "\[Eta]", ",", "n"}], "]"}], ",", 
      RowBox[{"\[Alpha]", ">", "0.0001"}]}], "}"}], ",", "\[Alpha]", ",", 
    RowBox[{"Method", "->", "\"\<RandomSearch\>\""}]}], "]"}]}]}], "Input",
