          RowBox[{
          "Eigenvalues", " ", "is", " ", "allowed", " ", "in", " ", "C", " ", 
           "target"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"-", 
          RowBox[{"Log2", "[", "\[Lambda]max", "]"}]}]}]}], 
