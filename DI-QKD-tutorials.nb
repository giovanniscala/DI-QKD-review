Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"<<", "MaTeX``"}], "\n", 
 RowBox[{"    ", 
  RowBox[{
   RowBox[{"r", "[", 
    RowBox[{"d_", ",", " ", "q_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pl", ",", " ", "e", ",", " ", "ep"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"pl", " ", "=", " ", 
       RowBox[{"pL", "[", "d", "]"}]}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"pl", " ", "<", " ", "0"}], " ", "||", " ", 
         RowBox[{"pl", " ", ">", " ", "1"}]}], ",", " ", 
        RowBox[{"Return", "[", "0", "]"}]}], "]"}], ";", " ", 
      RowBox[{"(*", " ", 
       RowBox[{"invalid", " ", "region"}], " ", "*)"}], "\n", "  ", 
      RowBox[{"e", " ", "=", " ", 
       RowBox[{"pl", "/", "4"}]}], ";", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{"base", " ", "error", " ", "from", " ", "pNL"}], " ", "*)"}], 
      "\n", "  ", 
      RowBox[{"ep", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"2", " ", "q"}]}], ")"}], " ", "e"}], " ", "+", " ", 
        "q"}]}], ";", "     ", 
      RowBox[{"(*", " ", 
       RowBox[{"post", "-", 
        RowBox[{"processed", " ", "error"}]}], " ", "*)"}], "\n", "  ", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"h", "[", "ep", "]"}], " ", "-", " ", 
       RowBox[{
        FractionBox["pl", "2"], 
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"h", "[", "q", "]"}]}], ")"}]}]}]}]}], "\n", "]"}]}], 
  "    "}], "\n", 
 RowBox[{"    ", 
  RowBox[{
   RowBox[{"rPRL07\[Eta]", "[", "\[Eta]_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h", ",", "Q", ",", "\[Beta]"}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"h", "[", "x_", "]"}], " ", ":=", " ", 
       RowBox[{"Piecewise", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"-", "x"}], " ", 
              RowBox[{"Log2", "[", "x", "]"}]}], " ", "-", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", " ", "-", " ", "x"}], ")"}], " ", 
              RowBox[{"Log2", "[", 
               RowBox[{"1", " ", "-", " ", "x"}], "]"}]}]}], ",", " ", 
            RowBox[{"0", " ", "<", " ", "x", " ", "<", " ", "1"}]}], "}"}], 
          "}"}], ",", " ", "0"}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"Q", "=", 
       RowBox[{"\[Eta]", 
        RowBox[{"(", 
         RowBox[{"1", "-", "\[Eta]"}], ")"}]}]}], ";", "\n", "\t", 
      RowBox[{"\[Beta]", "=", 
       RowBox[{
        RowBox[{"2", 
         SqrtBox["2"], 
         SuperscriptBox["\[Eta]", "2"]}], "+", 
        RowBox[{"2", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "-", "\[Eta]"}], ")"}], "2"]}]}]}], ";", "\n", "\t", 
      RowBox[{"1", "-", 
       RowBox[{"h", "[", "Q", "]"}], "-", 
       RowBox[{"h", "[", 
        FractionBox[
         RowBox[{"1", "+", 
          SqrtBox[
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"\[Beta]", "/", "2"}], ")"}], "2"], "-", "1"}]]}], "2"],
         "]"}]}]}]}], "\n", "\t", "]"}]}]}], "\n", 
 RowBox[{"\t", 
  RowBox[{
   RowBox[{"rBB84\[Eta]", "[", "\[Eta]_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Q", ",", "\[Beta]"}], "}"}], ",", "\n", "\t\t", 
     RowBox[{
      RowBox[{"Q", "=", 
       RowBox[{"\[Eta]", 
        RowBox[{"(", 
         RowBox[{"1", "-", "\[Eta]"}], ")"}]}]}], ";", "\n", "\t\t", 
      RowBox[{"\[Beta]", "=", 
       RowBox[{
        RowBox[{"2", 
         SqrtBox["2"], 
         SuperscriptBox["\[Eta]", "2"]}], "+", 
        RowBox[{"2", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"1", "-", "\[Eta]"}], ")"}], "2"]}]}]}], ";", "\n", "\t\t", 
      RowBox[{"1", "-", 
       RowBox[{"h", "[", "Q", "]"}], "-", 
       RowBox[{"h", "[", 
        RowBox[{"Q", "+", 
         FractionBox["\[Beta]", 
          RowBox[{"2", 
           SqrtBox["2"]}]]}], "]"}]}]}]}], "\n", "\t\t", "]"}]}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"rNPJ06M", "[", 
     RowBox[{"p_", ",", "M_"}], "]"}], ":=", 
    RowBox[{"1", "-", 
     RowBox[{"h", "[", 
      FractionBox[
       RowBox[{"1", "+", "p"}], "2"], "]"}], "-", 
     RowBox[{"M", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"p", " ", 
         RowBox[{"Cos", "[", 
          FractionBox["\[Pi]", 
           RowBox[{"2", "M"}]], "]"}]}]}], ")"}]}], "\n", "-", 
     RowBox[{"Log2", "[", 
      FractionBox[
       RowBox[{"1", "+", 
        SqrtBox[
         RowBox[{"2", "-", 
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox[
             RowBox[{"2", 
              SqrtBox["2"], 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"2", "Q"}]}], ")"}]}], "2"], ")"}], "2"]}]]}], "2"], 
      "]"}]}]}], "\n", "*)"}]}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rBB84\[Eta]", "[", "\[Eta]", "]"}], ",", 
     RowBox[{"rPRL07\[Eta]", "[", "\[Eta]", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Eta]", ",", ".85", ",", "1"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}]}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameTicksStyle", "\[Rule]", 
    RowBox[{"Directive", "[", 
     RowBox[{"Black", ",", "Thick"}], "]"}]}], ",", "\n", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"MaTeX", "[", 
       RowBox[{"\"\<\\\\eta\>\"", ",", 
        RowBox[{"Magnification", "\[Rule]", "1.5"}]}], "]"}], ",", 
      RowBox[{"MaTeX", "[", 
       RowBox[{"\"\<r\>\"", ",", 
        RowBox[{"Magnification", "\[Rule]", "1.5"}]}], "]"}]}], "}"}]}], ",", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
     "Red", ",", " ", "Blue", ",", " ", "Orange", ",", "Green", ",", 
      "Brown"}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"PlotRangePadding", " ", "->", " ", "None"}], ",", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"Placed", "[", "\n", "       ", 
     RowBox[{
      RowBox[{"{", "\n", "        ", 
       RowBox[{
        RowBox[{"MaTeX", "[", 
         RowBox[{"\"\<\\\\text{BB84}\>\"", ",", " ", 
          RowBox[{"Magnification", " ", "->", " ", "1"}]}], "]"}], ",", "\n", 
        "        ", 
        RowBox[{"MaTeX", "[", 
         RowBox[{"\"\<\\\\text{CHSH quant. col. attacks}\>\"", ",", " ", 
          RowBox[{"Magnification", " ", "->", " ", "1"}]}], "]"}], ",", "\n", 
        "        ", 
        RowBox[{"MaTeX", "[", 
         RowBox[{"\"\<\\\\text{CHSH no-signal attacks}\>\"", ",", " ", 
          RowBox[{"Magnification", " ", "->", " ", "1"}]}], "]"}]}], "     ", 
       "\n", "      ", "}"}], "\n", "    ", ",", 
      RowBox[{"{", 
       RowBox[{"0.35", ",", "0.75"}], "}"}]}], "]"}]}]}], "\n", "    ", 
  "]"}], "\n", 
