  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "SandElegant", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SandElegant", "[", 
      RowBox[{"\[Eta]_", ",", "\[Alpha]_", ",", "a_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Kappa]", ",", "r", ",", "\[Phi]", ",", "\[CapitalDelta]"}],
         "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Kappa]", "=", 
         RowBox[{"Exp", "[", 
          RowBox[{"2", " ", 
           RowBox[{"\[Alpha]", "^", "2"}], " ", 
           RowBox[{"(", 
            RowBox[{"\[Eta]", "-", "1"}], ")"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"r", "=", 
         RowBox[{"Erf", "[", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"2", " ", "\[Eta]"}], "]"}], " ", "\[Alpha]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"\[Phi]", "=", 
         RowBox[{"ArcTanh", "[", "\[Kappa]", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[CapitalDelta]", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"r", "^", "2"}], "+", 
           RowBox[{
            RowBox[{"Sinh", "[", 
             RowBox[{"\[Phi]", "/", "a"}], "]"}], "^", "2"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", 
          RowBox[{"a", "/", 
           RowBox[{"(", 
            RowBox[{"1", "-", "a"}], ")"}]}]}], "+", 
         RowBox[{
          RowBox[{"1", "/", 
           RowBox[{"(", 
            RowBox[{"1", "-", "a"}], ")"}]}], "*", 
          RowBox[{"Log2", "[", 
           RowBox[{
            RowBox[{"2", "^", "a"}], " ", 
            RowBox[{"Sech", "[", "\[Phi]", "]"}], "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Cosh", "[", 
                  RowBox[{"\[Phi]", "/", "a"}], "]"}], "-", 
                 "\[CapitalDelta]"}], ")"}], "^", "a"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Cosh", "[", 
                  RowBox[{"\[Phi]", "/", "a"}], "]"}], "+", 
                 "\[CapitalDelta]"}], ")"}], "^", "a"}]}], ")"}]}], 
           "]"}]}]}]}]}], "]"}]}], ";"}]}]}]], "Input",
