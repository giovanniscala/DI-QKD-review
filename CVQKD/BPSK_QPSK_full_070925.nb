Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"matPow", "=", 
     RowBox[{"Compile", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"vals", ",", "_Complex", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"vecs", ",", "_Complex", ",", "2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"p", ",", "_Real"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"inv", ",", "vecst"}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"vecst", "=", 
           RowBox[{"Transpose", "[", "vecs", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"vals", "=", 
             RowBox[{
              RowBox[{"clip\[Lambda]", "[", "vals", "]"}], "^", "p"}]}], 
            ";"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"inv", "=", 
           RowBox[{"Inverse", "[", "vecst", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"vecst", ".", 
           RowBox[{"DiagonalMatrix", "[", 
            RowBox[{"vals", "^", "p"}], "]"}], ".", "inv"}]}]}], 
        "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"CompilationTarget", "->", "\"\<C\>\""}], ",", 
       RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"normVecC", "=", 
     RowBox[{"Compile", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Alpha]", ",", "_Real"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Eta]", ",", "_Real"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"t", "=", 
            RowBox[{
             RowBox[{"\[Alpha]", "^", "2"}], " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", "\[Eta]"}], ")"}]}]}], ",", "e", ",", "e2", 
           ",", 
           RowBox[{"ns", "=", 
            RowBox[{"Table", "[", 
             RowBox[{"0.", ",", 
              RowBox[{"{", "4", "}"}]}], "]"}]}], ",", "s"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"e", "=", 
           RowBox[{"Exp", "[", 
            RowBox[{"-", "t"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"e2", "=", 
           RowBox[{"e", "*", "e"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ns", "[", 
              RowBox[{"[", 
               RowBox[{"s", "+", "1"}], "]"}], "]"}], "=", 
             RowBox[{"1.", "/", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"1.", "+", 
                RowBox[{"e2", "*", 
                 RowBox[{"Cos", "[", 
                  RowBox[{"\[Pi]", "*", "s"}], "]"}]}], "+", 
                RowBox[{"2.", "*", "e", "*", 
                 RowBox[{"Cos", "[", 
                  RowBox[{
                   RowBox[{"\[Pi]", "*", 
                    RowBox[{"s", "/", "2."}]}], "+", "t"}], "]"}]}]}], 
               "]"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"s", ",", "0", ",", "3"}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", "ns"}]}], "]"}], ",", "\[IndentingNewLine]", 
