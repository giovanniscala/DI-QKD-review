            RowBox[{"(", 
             RowBox[{"block", "-", 
              RowBox[{"diagonal", " ", "with", " ", "4", "\[Times]", "4", " ", 
               RowBox[{"identity", "\[CircleTimes]", "diag"}], 
               RowBox[{
                RowBox[{"(", "q", ")"}], "^", 
                RowBox[{"{", 
                 RowBox[{"-", "\.bd"}], "}"}]}]}]}], ")"}], "--"}]}], "-"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"s0", "=", 
              RowBox[{"1", "/", 
               RowBox[{"Sqrt", "[", "q0", "]"}]}]}], ",", 
             RowBox[{"s1", "=", 
              RowBox[{"1", "/", 
               RowBox[{"Sqrt", "[", "q1", "]"}]}]}], ",", 
             RowBox[{"s2", "=", 
              RowBox[{"1", "/", 
               RowBox[{"Sqrt", "[", "q2", "]"}]}]}], ",", 
             RowBox[{"s3", "=", 
              RowBox[{"1", "/", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"1.", "-", "q0", "-", "q1", "-", "q2"}], "]"}]}]}], 
             ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"i", "=", "0"}], ",", 
              RowBox[{"i", "<=", "3"}], ",", 
              RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"rho1", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"4", " ", "i"}], "+", "1"}], ",", 
                   RowBox[{
                    RowBox[{"4", " ", "i"}], "+", "1"}]}], "]"}], "]"}], "=", 
                "s0"}], ";", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"rho1", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"4", " ", "i"}], "+", "2"}], ",", 
                   RowBox[{
                    RowBox[{"4", " ", "i"}], "+", "2"}]}], "]"}], "]"}], "=", 
                "s1"}], ";", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"rho1", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"4", " ", "i"}], "+", "3"}], ",", 
                   RowBox[{
                    RowBox[{"4", " ", "i"}], "+", "3"}]}], "]"}], "]"}], "=", 
                "s2"}], ";", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"rho1", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"4", " ", "i"}], "+", "4"}], ",", 
                   RowBox[{
                    RowBox[{"4", " ", "i"}], "+", "4"}]}], "]"}], "]"}], "=", 
                "s3"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"--", 
            RowBox[{"-", "\[Rho]\:2082"}]}], "=", 
           RowBox[{
            RowBox[{
            "\[Rho]\:2081", " ", "\[Rho]YE", " ", "\[Rho]\:2081", " ", "and", 
             " ", "largest", " ", 
             RowBox[{"eigenvalue", "--"}]}], "-"}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"rho2", "=", 
          RowBox[{"rho1", ".", "rhoYE", ".", "rho1"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"\[Lambda]max", "=", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"Max", "@", 
             RowBox[{"Re", "@", 
              RowBox[{"Eigenvalues", "[", "rho2", "]"}]}]}], ",", 
            "MachinePrecision"}], "]"}]}], ";", "\[IndentingNewLine]", 
