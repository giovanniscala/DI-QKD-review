Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"We", " ", "recall", " ", "the", " ", 
    SuperscriptBox[
     SubscriptBox["p", "L"], 
     RowBox[{"j", ",", "r"}]], " ", "of", " ", "the", " ", "figure", " ", 
    "as", " ", 
    SubscriptBox["L", 
     RowBox[{"j", ",", "r"}]], " ", "below", " ", "and", " ", "we", " ", 
    "list", " ", "all", " ", "the", " ", "9", " ", "vertex", " ", "in", " ", 
    "\[ScriptCapitalL]"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["L", 
      RowBox[{"1", ",", "r_"}]], "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{"r", ",", "r", ",", 
      SubscriptBox["q", 
       RowBox[{"1", ",", "r"}]]}], "}"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     SubscriptBox["L", 
      RowBox[{"2", ",", "r_"}]], "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Mod", "[", 
       RowBox[{
        RowBox[{"x", "+", "r"}], ",", "2"}], "]"}], ",", "r", ",", 
      SubscriptBox["q", 
       RowBox[{"2", ",", "r"}]]}], "}"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     SubscriptBox["L", 
      RowBox[{"3", ",", "r_"}]], "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{"r", ",", 
      RowBox[{"Mod", "[", 
       RowBox[{
        RowBox[{"y", "+", "r"}], ",", "2"}], "]"}], ",", 
      SubscriptBox["q", 
       RowBox[{"3", ",", "r"}]]}], "}"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     SubscriptBox["L", 
      RowBox[{"4", ",", "r_"}]], "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Mod", "[", 
       RowBox[{
        RowBox[{"x", "+", "r"}], ",", "2"}], "]"}], ",", 
      RowBox[{"Mod", "[", 
       RowBox[{
        RowBox[{"y", "+", "r", "+", "1"}], ",", "2"}], "]"}], ",", 
      SubscriptBox["q", 
       RowBox[{"4", ",", "r"}]]}], "}"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     SubscriptBox["L", 
      RowBox[{"5", ",", "0"}]], "[", 
     RowBox[{"a_", ",", "b_", ",", "x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{
       FractionBox["1", "2"], 
       RowBox[{"KroneckerDelta", "[", 
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"a", "+", "b"}], ",", "2"}], "]"}], ",", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"x", " ", "y"}], ",", "2"}], "]"}]}], "]"}]}], ",", 
      FractionBox[
       SubscriptBox["p", "nl"], "2"]}], "}"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[ScriptCapitalL]", "[", 
     RowBox[{"a_", ",", "b_", ",", "x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Array", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            SubscriptBox["L", 
             RowBox[{"#1", ",", 
              RowBox[{"#2", "-", "1"}]}]], "[", 
            RowBox[{"x", ",", "y"}], "]"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "2"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{
           SubscriptBox["L", 
            RowBox[{"5", ",", "0"}]], "[", 
           RowBox[{"a", ",", "b", ",", "x", ",", "y"}], "]"}], "}"}], "}"}]}],
        "]"}], ",", "1"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p", "[", 
     RowBox[{"a_", ",", "b_", ",", "x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Total", "@", 
