Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Section", "::"}], " ", "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Random", "-", 
     RowBox[{"basis", " ", "DIQKD"}]}], " ", "\[Dash]", " ", 
    RowBox[{
     RowBox[{"Asymptotic", " ", "key"}], "-", 
     RowBox[{"rate", " ", "curves", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Fig", ".", " ", "2"}], " ", "replica"}], ")"}]}]}]}], "*)"}],
   "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Binary", " ", "entropy", " ", "in", " ", "bits"}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"h2", "[", 
      RowBox[{"p_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"p", " ", "==", " ", "0"}], " ", "||", " ", 
        RowBox[{"p", " ", "==", " ", "1"}]}], ",", " ", "0", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "p"}], " ", 
         RowBox[{"Log2", "[", "p", "]"}]}], " ", "-", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "p"}], ")"}], " ", 
         RowBox[{"Log2", "[", 
          RowBox[{"1", " ", "-", " ", "p"}], "]"}]}]}]}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Depolarising", "-", 
     RowBox[{
     "noise", " ", "QBER", " ", "as", " ", "a", " ", "function", " ", "of", 
      " ", "CHSH", " ", "value", " ", "S"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"qBER", "[", 
      RowBox[{"S_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"S", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}]}], ")"}]}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Eve", "-", 
      RowBox[{"uncertainty", " ", "bound", " ", "C", "*", 
       RowBox[{"(", "S", ")"}]}]}], " ", "\[Dash]", " ", 
     RowBox[{
      RowBox[{
      "here", " ", "we", " ", "insert", " ", "the", " ", "tight", " ", 
       "linear", " ", "approximation", "\n", "   ", "from", " ", "Schwonnek", 
       " ", "et", " ", 
       RowBox[{"al", "."}]}], ";", " ", 
      RowBox[{
      "replace", " ", "with", " ", "your", " ", "favourite", " ", "bound", 
       " ", "if", " ", "desired"}]}]}], "         ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Cstar", "[", 
      RowBox[{"S_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Log2", "[", "2", "]"}], " ", "-", " ", 
      RowBox[{"h2", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "+", " ", 
          RowBox[{"S", "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", 
             RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}]}], ")"}], "/", "2"}], 
       "]"}]}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Secret", "-", 
     RowBox[{"fraction", " ", "r\[Infinity]", " ", "and", " ", "key"}], "-", 
     RowBox[{
     "rate", " ", "K\[Infinity]", " ", "for", " ", "the", " ", "original", 
      " ", "APM", " ", "protocol"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"rInfAPM", "[", 
      RowBox[{"S_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Cstar", "[", "S", "]"}], " ", "-", " ", 
      RowBox[{"h2", "[", 
       RowBox[{"qBER", "[", "S", "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"KInfAPM", "[", 
      RowBox[{"S_", "?", "NumericQ"}], "]"}], "  ", ":=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], " ", 
      RowBox[{"rInfAPM", "[", "S", "]"}]}]}], ";", "          ", 
    RowBox[{"(*", " ", 
     RowBox[{"p", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"1", "/", "2"}], " ", "gives", " ", "ps"}], " ", "=", " ", 
       RowBox[{"1", "/", "2"}]}]}], " ", "*)"}], "\n", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Random", "-", 
        RowBox[{"basis", " ", 
         RowBox[{"protocol", ":", " ", 
          RowBox[{"choose", " ", "\[Lambda]"}]}]}]}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", "for", " ", "S"}], "\[LessEqual]", 
        "2.5"}]}], ",", " ", 
      RowBox[{
       RowBox[{"else", " ", "\[Lambda]"}], "=", "1"}]}], "               ", 
     "*)"}], "\n", 
    RowBox[{
     RowBox[{"lambda", "[", "S_", "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"S", " ", "<=", " ", "2.5"}], ",", " ", 
       RowBox[{"1", "/", "2"}], ",", " ", "1"}], "]"}]}], ";", 
    "               ", 
    RowBox[{"(*", " ", 
     RowBox[{"optimal", " ", "per", " ", "paper"}], " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{"rInfRB", "[", 
      RowBox[{"S_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"Cstar", "[", "S", "]"}], " ", "-", " ", 
      RowBox[{"h2", "[", 
       RowBox[{"qBER", "[", "S", "]"}], "]"}]}]}], ";", "    ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"same", " ", "Eve", " ", "bound"}], ",", " ", 
      RowBox[{
      "different", " ", "\[Lambda]", " ", "handled", " ", "via", " ", "p"}]}],
      " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{"KInfRB", "[", 
      RowBox[{"S_", "?", "NumericQ"}], "]"}], "  ", ":=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}], " ", 
      RowBox[{"rInfRB", "[", "S", "]"}]}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Plotting", " ", "window"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Smin", " ", "=", " ", "2.0"}], ";", " ", 
    RowBox[{"Smax", " ", "=", " ", 
     RowBox[{"2", " ", 
      RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";"}], "\n", "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"KInfAPM", "[", "S", "]"}], ",", " ", 
       RowBox[{"KInfRB", "[", "S", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"S", ",", " ", "Smin", ",", " ", "Smax"}], "}"}], ",", "\n", 
     " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", " ", 
        RowBox[{"Darker", "[", "Red", "]"}]}], "}"}]}], ",", "\n", " ", 
