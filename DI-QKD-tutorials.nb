              RowBox[{"Log2", "[", 
               RowBox[{"1", " ", "-", " ", "x"}], "]"}]}]}], ",", " ", 
            RowBox[{"0", " ", "<", " ", "x", " ", "<", " ", "1"}]}], "}"}], 
          "}"}], ",", " ", "0"}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"1", "-", 
       RowBox[{"h", "[", 
        FractionBox[
         RowBox[{"1", "-", "\[Nu]"}], "2"], "]"}], "-", 
       RowBox[{"Log2", "[", 
        RowBox[{"1", "+", 
         SqrtBox[
          RowBox[{"2", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             SuperscriptBox["\[Nu]", "2"]}], ")"}]}]]}], "]"}]}]}]}], "\n", 
    "\t", "]"}]}]}], "\n", 
