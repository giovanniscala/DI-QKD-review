  RowBox[{
   RowBox[{"RateAEPList", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SuperscriptBox["10", "x"], ",", 
        RowBox[{"RateAEP", "[", 
         RowBox[{"1", ",", "0.9", ",", 
          SuperscriptBox["10", "x"], ",", 
          SuperscriptBox["10", 
           RowBox[{"-", "8"}]]}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"Log10", "[", "100", "]"}], ",", 
        RowBox[{"Log10", "[", "100000000", "]"}], ",", "0.4"}], "}"}]}], 
     "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"RateAEPList70", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
