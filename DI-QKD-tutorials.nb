   3.960313047655551*^9}, {3.960313224614442*^9, 3.960313225038395*^9}, {
   3.9603162264196177`*^9, 3.9603162416912775`*^9}, {3.9603162742939043`*^9, 
   3.9603164316597767`*^9}, {3.960316481548518*^9, 3.9603165611983075`*^9}, {
   3.960316662194164*^9, 3.9603166930780535`*^9}, 3.96054062725479*^9, 
   3.960540657897771*^9},
