Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bYEQ", "[", 
   RowBox[{"\[Alpha]_", ",", "\[Eta]_", ",", "a0_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Hd2YE", ",", "HdaYE", ",", "HYE", ",", "VYE", ",", "K", ",", 
      "\[Rho]YE\[Eta]\[Alpha]", ",", "\[Rho]E\[Eta]\[Alpha]", ",", 
      RowBox[{"a", "=", "a0"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Rho]E\[Eta]\[Alpha]", "=", 
      RowBox[{"\[Rho]E", "[", 
       RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Rho]YE\[Eta]\[Alpha]", "=", 
      RowBox[{"\[Rho]YE", "[", 
       RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"HYE", "=", 
      RowBox[{"Re", "@", 
       RowBox[{"HvonCond", "[", 
        RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"VYE", "=", 
      RowBox[{"Re", "@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Tr", "[", 
           RowBox[{"\[Rho]YE\[Eta]\[Alpha]", ".", 
            RowBox[{"MatrixPower", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"MatrixLog", "[", "\[Rho]YE\[Eta]\[Alpha]", "]"}], 
                "-", 
                RowBox[{"MatrixLog", "[", 
                 RowBox[{"id4", "\[CircleDot]", "\[Rho]E\[Eta]\[Alpha]"}], 
                 "]"}]}], ")"}], ",", "2"}], "]"}]}], "]"}], "/", 
          RowBox[{"(", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"Log", "[", "2", "]"}], ")"}], "2"], ")"}]}], "-", 
         SuperscriptBox["HYE", "2"]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Hd2YE", "=", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"1", "-", "2"}]], 
       RowBox[{"Log2", "[", 
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"MatrixPower", "[", 
           RowBox[{"\[Rho]YE\[Eta]\[Alpha]", ",", "2"}], "]"}], ".", 
          RowBox[{"MatrixPower", "[", 
           RowBox[{
            RowBox[{"id4", "\[CircleDot]", "\[Rho]E\[Eta]\[Alpha]"}], ",", 
            RowBox[{"1", "-", "2"}]}], "]"}]}], "]"}], "]"}]}]}], ";", " ", 
     RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"HdaYE", "=", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"1", "-", "a"}]], 
       RowBox[{"Log2", "[", 
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"MatrixPower", "[", 
           RowBox[{"\[Rho]YE\[Eta]\[Alpha]", ",", "a"}], "]"}], ".", 
          RowBox[{"MatrixPower", "[", 
           RowBox[{
            RowBox[{"id4", "\[CircleDot]", "\[Rho]E\[Eta]\[Alpha]"}], ",", 
            RowBox[{"1", "-", "a"}]}], "]"}]}], "]"}], "]"}]}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"K", "=", 
      RowBox[{"Re", "@", 
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"6", 
           SuperscriptBox[
