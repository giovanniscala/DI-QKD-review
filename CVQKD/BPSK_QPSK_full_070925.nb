        RowBox[{"K", "=", 
         RowBox[{"Re", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1.", "/", 
             RowBox[{"(", 
              RowBox[{"6.", " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"2.", "-", "a"}], ")"}], "^", "3"}], " ", 
               RowBox[{"Log", "[", "2.", "]"}]}], ")"}]}], ")"}], "*", 
