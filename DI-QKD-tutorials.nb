     "\[IndentingNewLine]", "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"AES", " ", "Decryption", " ", "Procedure"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"aesDecrypt", "[", 
     RowBox[{"encryptedText_", ",", "key_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "block", ",", "roundKey", ",", "substitutedBlock", ",", "shiftedBlock",
         ",", "decryptedBlock"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Step", " ", "1"}], ":", 
        RowBox[{
        "Convert", " ", "encrypted", " ", "text", " ", "to", " ", "block"}]}],
        "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"block", "=", 
        RowBox[{"textToBlock", "[", "encryptedText", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Step", " ", "2"}], ":", 
         RowBox[{"Initial", " ", "round", " ", 
          RowBox[{"(", "AddRoundKey", ")"}]}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"roundKey", "=", 
        RowBox[{"textToBlock", "[", "key", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"First", " ", "round", " ", "key"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"block", "=", 
        RowBox[{"addRoundKey", "[", 
         RowBox[{"block", ",", "roundKey"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Step", " ", "3"}], ":", 
         RowBox[{"Inverse", " ", "ShiftRows", " ", "operation"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"shiftedBlock", "=", 
        RowBox[{"invShiftRows", "[", "block", "]"}]}], ";", 
