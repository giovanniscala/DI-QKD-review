         RowBox[{"rhoYE", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"0.", "+", 
             RowBox[{"0.", "I"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"16", ",", "16"}], "}"}]}], "]"}]}], " ", ",", 
         RowBox[{"valsYE", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.", ",", "16"}], "]"}]}], ",", 
         RowBox[{"vecsYE", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"0.", "+", 
             RowBox[{"0.", "I"}]}], ",", 
            RowBox[{"{", "16", "}"}], ",", 
            RowBox[{"{", "16", "}"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"idRhoE", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.", ",", 
            RowBox[{"{", 
             RowBox[{"16", ",", "16"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"valsId", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.", ",", "16"}], "]"}]}], ",", "\[IndentingNewLine]", 
         "rhoYEa", ",", "idRhoE1a", ",", "\[IndentingNewLine]", "MatLogrhoYE",
          ",", "diff", ",", "HYE", ",", "VYE", ",", "Hd2", ",", "Hda", ",", 
         "K"}], 
        RowBox[{"(*", 
         RowBox[{"real", "?"}], "*)"}], "}"}], ",", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"rhoE", "=", 
         RowBox[{"rhoECompiled", "[", 
          RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}]}], ";", " ", 
        RowBox[{"(*", "real", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"valsE", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Re", "[", 
           RowBox[{"Eigenvalues", "[", "rhoE", "]"}], "]"}], "]"}]}], ";", 
        RowBox[{"(*", "real", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"rhoYE", "=", 
         RowBox[{"rhoYECompiled", "[", 
          RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}]}], ";", 
        RowBox[{"(*", "complex", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"valsYE", "=", 
         RowBox[{"Flatten", "@", 
          RowBox[{"Re", "[", 
           RowBox[{"Eigenvalues", "[", "rhoYE", "]"}], "]"}]}]}], ";", 
        RowBox[{"(*", "complex", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"vecsYE", "=", 
         RowBox[{"Chop", "[", 
          RowBox[{"Transpose", "[", 
           RowBox[{"Eigenvectors", "[", "rhoYE", "]"}], "]"}], "]"}]}], ";", 
        RowBox[{"(*", "complex", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"idRhoE", "=", 
         RowBox[{
          RowBox[{"diagRe", "[", 
           RowBox[{"{", 
            RowBox[{"1.", ",", "1.", ",", "1.", ",", "1."}], "}"}], "]"}], 
          "~", "KroneckerProduct", "~", 
          RowBox[{"diagRe", "[", 
           RowBox[{"{", 
            RowBox[{"q0", ",", "q1", ",", "q2", ",", 
             RowBox[{"(", 
              RowBox[{"1", "-", "q0", "-", "q1", "-", "q2"}], ")"}]}], "}"}], 
           "]"}]}]}], ";", " ", 
        RowBox[{"(*", "real", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"valsId", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Re", "[", 
           RowBox[{"Eigenvalues", "[", "idRhoE", "]"}], "]"}], "]"}]}], ";", 
        RowBox[{"(*", "real", "*)"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"eleviamo", " ", "a", " ", "potenza"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"rhoYEa", "=", 
         RowBox[{"Chop", "[", 
          RowBox[{"matPow", "[", 
           RowBox[{"valsYE", ",", "vecsYE", ",", "a"}], "]"}], "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"forse", " ", "si", " ", "pu\[OGrave]", " ", "cambiare"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"idRhoE1a", "=", 
         RowBox[{"diagRe", "[", 
          RowBox[{"valsId", "^", 
           RowBox[{"(", 
            RowBox[{"1.", "-", "a"}], ")"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"entropia", " ", "condizionata"}], "\[Dash]", 
          RowBox[{"formula", " ", "solo", " ", "su", " ", "vettori"}]}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"MatLogrhoYE", "=", 
         RowBox[{"vecsYE", ".", 
          RowBox[{"diagRe", "[", 
           RowBox[{"Log", "[", "valsYE", "]"}], "]"}], ".", 
          RowBox[{"ConjugateTranspose", "[", "vecsYE", "]"}]}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"non", " ", "sappiamo", " ", "su", " ", 
          RowBox[{"Re", "[", "valsYE", "]"}], " ", "diventa", " ", "real"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"diff", "=", 
         RowBox[{"MatLogrhoYE", "-", 
          RowBox[{"diagRe", "[", 
           RowBox[{"Log", "[", "valsId", "]"}], "]"}]}]}], ";", " ", 
        RowBox[{"(*", "real", "*)"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"HYE", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"0.", ",", 
           RowBox[{"Re", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", 
                RowBox[{"Tr", "[", 
                 RowBox[{"rhoYE", ".", "MatLogrhoYE"}], "]"}]}], "+", 
               RowBox[{"Total", "[", 
                RowBox[{"valsE", " ", 
                 RowBox[{"Log", "[", "valsE", "]"}]}], "]"}]}], ")"}], "/", 
