Cell[BoxData[{
 RowBox[{"ClearAll", ";"}], "\n", 
 RowBox[{
  RowBox[{"rpg", "[", "Q_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"h", ",", "\[Beta]"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"h", "[", "x_", "]"}], " ", ":=", " ", 
      RowBox[{"Piecewise", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"-", "x"}], " ", 
             RowBox[{"Log2", "[", "x", "]"}]}], " ", "-", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", " ", "-", " ", "x"}], ")"}], " ", 
             RowBox[{"Log2", "[", 
              RowBox[{"1", " ", "-", " ", "x"}], "]"}]}]}], ",", " ", 
           RowBox[{"0", " ", "<", " ", "x", " ", "<", " ", "1"}]}], "}"}], 
         "}"}], ",", " ", "0"}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"\[Beta]", "=", 
      RowBox[{"2", 
       SqrtBox["2"], 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"2", "Q"}]}], ")"}]}]}], ";", "\n", "\t", 
     RowBox[{"1", "-", 
      RowBox[{"h", "[", "Q", "]"}], "-", 
      RowBox[{"Log2", "[", 
       RowBox[{"1", "+", 
        SqrtBox[
         RowBox[{"2", "-", 
          FractionBox[
           SuperscriptBox["\[Beta]", "2"], "4"]}]]}], "]"}]}]}]}], "\n", "\t",
    "]"}]}], "\n", 
 RowBox[{"\t", 
  RowBox[{
   RowBox[{"rpg\[Nu]", "[", "\[Nu]_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "h", "}"}], ",", "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{"h", "[", "x_", "]"}], " ", ":=", " ", 
       RowBox[{"Piecewise", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"-", "x"}], " ", 
              RowBox[{"Log2", "[", "x", "]"}]}], " ", "-", " ", 
