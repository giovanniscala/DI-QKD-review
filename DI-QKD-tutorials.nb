Cell[BoxData[{
 RowBox[{"ClearAll", ";"}], "\n", 
 RowBox[{
  RowBox[{"r\[Chi]", "[", 
   RowBox[{"\[Eta]_", ",", "pgm_", ",", "q_", ",", "\[Beta]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"h", ",", "\[Chi]", ",", "\[Beta]1", ",", "\[Beta]2", ",", "Q"}],
      "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"h", "[", "x_", "]"}], " ", ":=", " ", 
      RowBox[{"Piecewise", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"-", "x"}], " ", 
             RowBox[{"Log2", "[", "x", "]"}]}], " ", "-", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", " ", "-", " ", "x"}], ")"}], " ", 
             RowBox[{"Log2", "[", 
              RowBox[{"1", " ", "-", " ", "x"}], "]"}]}]}], ",", " ", 
           RowBox[{"0", " ", "<", " ", "x", " ", "<", " ", "1"}]}], "}"}], 
         "}"}], ",", " ", "0"}], "]"}]}], ";", "\n", "\t", 
     RowBox[{
      RowBox[{"\[Chi]", "[", "\[Beta]0_", "]"}], ":=", 
      RowBox[{"h", "[", 
       RowBox[{
        FractionBox["1", "2"], "+", 
        RowBox[{
         FractionBox["1", "2"], 
         SqrtBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox["\[Beta]0", "2"], ")"}], "2"], "-", "1"}]]}]}], 
       "]"}]}], ";", "\n", "\t", 
     RowBox[{"Q", "=", 
      RowBox[{"\[Eta]", 
       RowBox[{"(", 
        RowBox[{"1", "-", "\[Eta]"}], ")"}]}]}], ";", "\n", "\t", 
     RowBox[{"\[Beta]1", "=", 
      RowBox[{
       RowBox[{"4", "pgm"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "pgm"}], ")"}], "2"}]}]}], ";", "\n", "\t", 
     RowBox[{"\[Beta]2", "=", 
      RowBox[{
       RowBox[{"2", 
        SqrtBox["2"], 
        SuperscriptBox["\[Eta]", "2"]}], "+", 
       RowBox[{"2", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Eta]"}], ")"}], "2"]}]}]}], ";", "\n", "\t", 
     "\n", "\t", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"\[Beta]", "==", "1"}], ",", 
       RowBox[{"1", "-", 
        RowBox[{"h", "[", "Q", "]"}], "-", "pgm", "-", 
        RowBox[{"h", "[", 
         FractionBox[
          RowBox[{"1", "+", 
           SqrtBox[
            RowBox[{"1", "-", 
             RowBox[{"q", 
              RowBox[{"(", 
               RowBox[{"1", "-", "q"}], ")"}], 
              RowBox[{"(", 
               RowBox[{"8", "-", 
                SuperscriptBox["\[Beta]1", "2"]}], ")"}]}]}]]}], "2"], "]"}], 
        "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "pgm"}], ")"}], 
         RowBox[{"\[Chi]", "[", "\[Beta]1", "]"}]}]}], ",", 
       RowBox[{"1", "-", 
        RowBox[{"h", "[", "Q", "]"}], "-", "pgm", "-", 
        RowBox[{"h", "[", 
         FractionBox[
          RowBox[{"1", "+", 
           SqrtBox[
            RowBox[{"1", "-", 
             RowBox[{"q", 
              RowBox[{"(", 
               RowBox[{"1", "-", "q"}], ")"}], 
              RowBox[{"(", 
               RowBox[{"8", "-", 
                SuperscriptBox["\[Beta]2", "2"]}], ")"}]}]}]]}], "2"], "]"}], 
        "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "pgm"}], ")"}], 
         RowBox[{"\[Chi]", "[", "\[Beta]2", "]"}]}]}]}], "]"}]}]}], "\n", 
   "\t", "]"}]}], "\n", 
 RowBox[{"\t", 
  RowBox[{"r\[Chi]", "[", 
   RowBox[{".99", ",", "0", ",", "0", ",", "1"}], "]"}]}]}], "Code",
 CellChangeTimes->{
  3.9608788645220585`*^9},ExpressionUUID->"765c28c6-9400-480d-8594-\
b818d114a48b"]
}, Closed]],

