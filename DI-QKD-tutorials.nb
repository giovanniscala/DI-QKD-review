Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"<<", "MaTeX``"}], "\n", 
 RowBox[{"  ", 
  RowBox[{
   RowBox[{"r", "[", 
    RowBox[{"d_", ",", " ", "q_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pl", ",", " ", "e", ",", " ", "ep"}], "}"}], ",", "\n", 
     "        ", 
     RowBox[{
      RowBox[{"pl", " ", "=", " ", 
       RowBox[{"pL", "[", "d", "]"}]}], ";", "\n", "        ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"pl", " ", "<", " ", "0"}], " ", "||", " ", 
         RowBox[{"pl", " ", ">", " ", "1"}]}], ",", " ", 
        RowBox[{"Return", "[", "0", "]"}]}], "]"}], ";", " ", 
      RowBox[{"(*", " ", 
       RowBox[{"invalid", " ", "region"}], " ", "*)"}], "\n", "        ", 
      RowBox[{"e", " ", "=", " ", 
       RowBox[{"pl", "/", "4"}]}], ";", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{"base", " ", "error", " ", "from", " ", "pNL"}], " ", "*)"}], 
      "\n", "        ", 
      RowBox[{"ep", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", 
           RowBox[{"2", " ", "q"}]}], ")"}], " ", "e"}], " ", "+", " ", 
        "q"}]}], ";", "     ", 
      RowBox[{"(*", " ", 
       RowBox[{"post", "-", 
        RowBox[{"processed", " ", "error"}]}], " ", "*)"}], "\n", "        ", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"h", "[", "ep", "]"}], " ", "-", " ", 
       RowBox[{
        FractionBox["pl", "2"], 
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", 
          RowBox[{"h", "[", "q", "]"}]}], ")"}]}]}]}]}], "\n", "]"}]}], 
  "    "}], "\n", 
 RowBox[{"    ", 
  RowBox[{
   RowBox[{"rPRL07", "[", "Q_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h", ",", "\[Beta]"}], "}"}], ",", "\n", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"h", "[", "x_", "]"}], " ", ":=", " ", 
       RowBox[{"Piecewise", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"-", "x"}], " ", 
              RowBox[{"Log2", "[", "x", "]"}]}], " ", "-", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", " ", "-", " ", "x"}], ")"}], " ", 
              RowBox[{"Log2", "[", 
               RowBox[{"1", " ", "-", " ", "x"}], "]"}]}]}], ",", " ", 
            RowBox[{"0", " ", "<", " ", "x", " ", "<", " ", "1"}]}], "}"}], 
          "}"}], ",", " ", "0"}], "]"}]}], ";", "\n", "\t", 
      RowBox[{"\[Beta]", "=", 
       RowBox[{"2", 
        SqrtBox["2"], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"2", "Q"}]}], ")"}]}]}], ";", "\n", "\t", 
      RowBox[{"1", "-", 
       RowBox[{"h", "[", "Q", "]"}], "-", 
       RowBox[{"h", "[", 
        FractionBox[
         RowBox[{"1", "+", 
          SqrtBox[
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"\[Beta]", "/", "2"}], ")"}], "2"], "-", "1"}]]}], "2"],
         "]"}]}]}]}], "\n", "\t", "]"}]}]}], "\n", 
 RowBox[{"\t", 
  RowBox[{
   RowBox[{"rBB84", "[", "Q_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[Beta]", "}"}], ",", "\n", "\t\t", 
     RowBox[{
      RowBox[{"\[Beta]", "=", 
       RowBox[{"2", 
        SqrtBox["2"], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"2", "Q"}]}], ")"}]}]}], ";", "\n", "\t\t", 
      RowBox[{"1", "-", 
       RowBox[{"h", "[", "Q", "]"}], "-", 
       RowBox[{"h", "[", 
        RowBox[{"Q", "+", 
         FractionBox["\[Beta]", 
          RowBox[{"2", 
           SqrtBox["2"]}]]}], "]"}]}]}]}], "\n", "\t\t", "]"}]}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"rNPJ06M", "[", 
     RowBox[{"p_", ",", "M_"}], "]"}], ":=", 
    RowBox[{"1", "-", 
     RowBox[{"h", "[", 
      FractionBox[
       RowBox[{"1", "+", "p"}], "2"], "]"}], "-", 
     RowBox[{"M", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"p", " ", 
         RowBox[{"Cos", "[", 
          FractionBox["\[Pi]", 
           RowBox[{"2", "M"}]], "]"}]}]}], ")"}]}], "\n", "-", 
     RowBox[{"Log2", "[", 
      FractionBox[
       RowBox[{"1", "+", 
        SqrtBox[
         RowBox[{"2", "-", 
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox[
             RowBox[{"2", 
              SqrtBox["2"], 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                RowBox[{"2", "Q"}]}], ")"}]}], "2"], ")"}], "2"]}]]}], "2"], 
      "]"}]}]}], "\n", "*)"}]}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rBB84", "[", "Q", "]"}], ",", 
     RowBox[{"rPRL07", "[", "Q", "]"}], ",", 
     RowBox[{"r", "[", 
      RowBox[{"Q", ",", "0"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"Q", ",", "0", ",", "0.14"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}]}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameTicksStyle", "\[Rule]", 
    RowBox[{"Directive", "[", 
     RowBox[{"Black", ",", "Thick"}], "]"}]}], ",", "\n", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"MaTeX", "[", 
       RowBox[{"\"\<Q\>\"", ",", 
        RowBox[{"Magnification", "\[Rule]", "1.5"}]}], "]"}], ",", 
      RowBox[{"MaTeX", "[", 
       RowBox[{"\"\<r\>\"", ",", 
        RowBox[{"Magnification", "\[Rule]", "1.5"}]}], "]"}]}], "}"}]}], ",", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
     "Red", ",", " ", "Blue", ",", " ", "Orange", ",", "Green", ",", 
      "Brown"}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"PlotRangePadding", " ", "->", " ", "None"}], ",", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"Placed", "[", "\n", "       ", 
     RowBox[{
      RowBox[{"{", "\n", "        ", 
       RowBox[{
        RowBox[{"MaTeX", "[", 
         RowBox[{"\"\<\\\\text{BB84}\>\"", ",", " ", 
          RowBox[{"Magnification", " ", "->", " ", "1"}]}], "]"}], ",", "\n", 
        "        ", 
        RowBox[{"MaTeX", "[", 
         RowBox[{"\"\<\\\\text{CHSH quant. col. attacks}\>\"", ",", " ", 
          RowBox[{"Magnification", " ", "->", " ", "1"}]}], "]"}], ",", "\n", 
        "        ", 
        RowBox[{"MaTeX", "[", 
         RowBox[{"\"\<\\\\text{CHSH no-signal attacks}\>\"", ",", " ", 
          RowBox[{"Magnification", " ", "->", " ", "1"}]}], "]"}]}], "     ", 
       "\n", "      ", "}"}], "\n", "    ", ",", 
      RowBox[{"{", 
       RowBox[{"0.65", ",", "0.75"}], "}"}]}], "]"}]}]}], "\n", "    ", 
  "]"}], "\n", 
 RowBox[{"     "}]}], "Code",
