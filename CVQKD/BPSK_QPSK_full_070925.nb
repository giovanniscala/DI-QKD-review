Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "PetzDownElegant", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"PetzDownElegant", "[", 
   RowBox[{"\[Eta]_", ",", "\[Alpha]_", ",", "a_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Kappa]", ",", "r", ",", "g", ",", "\[Theta]", ",", "\[Phi]"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Kappa]", "=", 
      RowBox[{"Exp", "[", 
       RowBox[{"2", " ", 
        RowBox[{"\[Alpha]", "^", "2"}], " ", 
        RowBox[{"(", 
         RowBox[{"\[Eta]", "-", "1"}], ")"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"r", "=", 
      RowBox[{"Erf", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"2", " ", "\[Eta]"}], "]"}], " ", "\[Alpha]"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"g", "=", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Kappa]", "^", 
            RowBox[{"-", "2"}]}], "-", "1"}], ")"}], " ", 
         RowBox[{"r", "^", "2"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Theta]", "=", 
      RowBox[{"ArcTanh", "[", 
       RowBox[{"\[Kappa]", " ", "g"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Phi]", "=", 
      RowBox[{"ArcTanh", "[", "\[Kappa]", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"1", "-", "a"}], ")"}]}], "*", 
       RowBox[{"Log", "[", 
        RowBox[{"2", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Sech", "[", "\[Theta]", "]"}], "^", "a"}], "*", 
          RowBox[{
           RowBox[{"Sech", "[", "\[Phi]", "]"}], "^", 
           RowBox[{"(", 
            RowBox[{"1", "-", "a"}], ")"}]}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Cosh", "[", 
              RowBox[{"a", " ", "\[Theta]"}], "]"}], " ", 
             RowBox[{"Cosh", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", "a"}], ")"}], " ", "\[Phi]"}], "]"}]}], "+", 
            RowBox[{
             RowBox[{"g", "^", 
              RowBox[{"-", "1"}]}], " ", 
             RowBox[{"Sinh", "[", 
              RowBox[{"a", " ", "\[Theta]"}], "]"}], " ", 
             RowBox[{"Sinh", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", "a"}], ")"}], " ", "\[Phi]"}], "]"}]}]}], 
           ")"}]}]}], "]"}]}]}]}]}], "]"}]}], "\n", 
 RowBox[{"PetzDownElegant", "[", 
  RowBox[{"0.9", ",", "4", ",", "1.1"}], "]"}]}], "Input",
