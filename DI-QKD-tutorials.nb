Cell["\<\
S. Pironio, A. Ac\[IAcute]n, N. Brunner, N. Gisin, S. Massar, V. Scarani, \
\[OpenCurlyDoubleQuote]Device-independent quantum key distribution secure \
against collective attacks\[CloseCurlyDoubleQuote], NJP 11 (2009) 04502 (2009)\
\>", "Text",
 CellChangeTimes->{{3.9605444640299473`*^9, 3.9605444832929344`*^9}, 
   3.9605451846184587`*^9, {3.960549587487589*^9, 3.9605496103202753`*^9}, {
