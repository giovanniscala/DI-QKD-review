Cell[BoxData[{
 RowBox[{"<<", "MaTeX`"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{"Binary", " ", "entropy", " ", "function"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"Piecewise", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"-", "x"}], " ", 
          RowBox[{"Log2", "[", "x", "]"}]}], " ", "-", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "x"}], ")"}], " ", 
          RowBox[{"Log2", "[", 
           RowBox[{"1", " ", "-", " ", "x"}], "]"}]}]}], ",", " ", 
        RowBox[{"0", " ", "<", " ", "x", " ", "<", " ", "1"}]}], "}"}], "}"}],
      ",", " ", "0"}], "]"}]}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Nonlocal", " ", "weight", " ", "as", " ", "function", " ", "of", " ", 
    "disturbance", " ", "D"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"pNL", "[", "d_", "]"}], " ", ":=", " ", 
