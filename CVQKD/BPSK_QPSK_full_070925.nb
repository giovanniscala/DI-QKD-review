        RowBox[{"q1", ",", "_Real"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"q2", ",", "_Real"}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rhoE", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.", ",", 
            RowBox[{"{", 
             RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"valsE", "=", 
          RowBox[{"ConstantArray", "[", 
