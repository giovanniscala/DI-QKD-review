Cell[BoxData[{
 RowBox[{"encryptedText", ";"}], "\[IndentingNewLine]", 
 RowBox[{"key", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"subByte", "=", 
    RowBox[{"RandomSample", "[", 
     RowBox[{"Range", "[", 
      RowBox[{"1", ",", "5"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "1"}], ":", 
    RowBox[{
    "Convert", " ", "encrypted", " ", "text", " ", "to", " ", "block"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"block", "=", 
    RowBox[{"textToBlock", "[", "encryptedText", "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "2"}], ":", 
    RowBox[{"Initial", " ", "round", " ", 
     RowBox[{"(", "AddRoundKey", ")"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"roundKey", "=", 
    RowBox[{"textToBlock", "[", "key", "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"First", " ", "round", " ", "key"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"block", "=", 
   RowBox[{"addRoundKey", "[", 
    RowBox[{"block", ",", "roundKey"}], "]"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "3"}], ":", 
    RowBox[{"Inverse", " ", "ShiftRows", " ", "operation"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"shiftedBlock", "=", 
   RowBox[{"invShiftRows", "[", "block", "]"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "4"}], ":", 
    RowBox[{"Inverse", " ", "SubBytes", " ", "operation"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"substitutedBlock", "=", 
   RowBox[{"invSubBytes", "[", "shiftedBlock", "]"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Step", " ", "5"}], ":", 
    RowBox[{"AddRoundKey", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"for", " ", "the", " ", "final", " ", "round"}], ",", 
       "typically"}], ")"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"decryptedBlock", "=", 
    RowBox[{"addRoundKey", "[", 
     RowBox[{"substitutedBlock", ",", "roundKey"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Return", " ", "the", " ", "decrypted", " ", "block", " ", "as", " ", 
    "text"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"blockToText", "[", "decryptedBlock", "]"}], ";"}]}], "Input",
