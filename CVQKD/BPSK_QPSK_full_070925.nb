Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"objFun", "[", 
     RowBox[{
      RowBox[{"\[Alpha]_", "?", "NumericQ"}], ",", 
      RowBox[{"a_", "?", "NumericQ"}], ",", 
      RowBox[{"q0_", "?", "NumericQ"}], ",", 
      RowBox[{"q1_", "?", "NumericQ"}], ",", 
      RowBox[{"q2_", "?", "NumericQ"}], ",", 
      RowBox[{"\[Eta]_", "?", "NumericQ"}], ",", 
      RowBox[{"n_", "?", "NumericQ"}], ",", "fun_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"val", ",", 
        RowBox[{"safe", "=", "True"}], ",", 
        RowBox[{"penalty", "=", 
         RowBox[{"10", "^", "6"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"a", "<=", "1.01"}], "||", 
          RowBox[{"\[Alpha]", "<=", 
           RowBox[{"10", "^", 
            RowBox[{"-", "6"}]}]}], "||", 
          RowBox[{"q0", "<", "0."}], "||", 
          RowBox[{"q1", "<", "0."}], "||", 
          RowBox[{"q2", "<", "0."}], "||", 
          RowBox[{
           RowBox[{"q0", "+", "q1", "+", "q2"}], ">", "0.999999"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"-", "penalty"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
        RowBox[{"Check", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"val", "=", 
            RowBox[{
             RowBox[{"fun", "[", 
              RowBox[{
              "\[Alpha]", ",", "\[Eta]", ",", "a", ",", "q0", ",", "q1", ",", 
               "q2"}], "]"}], "-", 
             RowBox[{
              RowBox[{"Log", "[", 
               RowBox[{"2.", "/", 
                RowBox[{"10.", "^", 
                 RowBox[{"(", 
                  RowBox[{"-", "16"}], ")"}]}]}], "]"}], "/", 
              RowBox[{"(", 
               RowBox[{"n", " ", 
                RowBox[{"(", 
                 RowBox[{"a", "-", "1."}], ")"}]}], ")"}]}], "-", 
             RowBox[{"compiledLeak", "[", 
              RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"val", "=", 
            RowBox[{"Chop", "@", 
             RowBox[{"Re", "@", "val"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"NumericQ", "[", "val", "]"}], "&&", 
              RowBox[{"FreeQ", "[", 
               RowBox[{"val", ",", 
                RowBox[{
                "ComplexInfinity", "|", "Indeterminate", "|", "Infinity"}]}], 
               "]"}]}], ",", "val", ",", 
             RowBox[{"safe", "=", "False"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"safe", "=", "False"}]}], "\[IndentingNewLine]", "]"}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"safe", ",", "val", ",", 
         RowBox[{"-", "penalty"}]}], "]"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Rate", "[", 
    RowBox[{
     RowBox[{"\[Eta]_", "?", "NumericQ"}], ",", 
     RowBox[{"n_", "?", "NumericQ"}], ",", "fun_", ",", 
     RowBox[{"trials_Integer", ":", "6"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "results", ",", "seeds", ",", "obj", ",", "best", ",", "q0", ",", "q1", 
       ",", "q2", ",", "a", ",", "\[Alpha]"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"seeds", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{"Join", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"RandomReal", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0.01", ",", "0.99"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"trials", ",", "3"}], "}"}]}], "]"}], ",", 
           RowBox[{"List", "/@", 
            RowBox[{"RandomReal", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1.0001", ",", "1.5"}], "}"}], ",", "trials"}], 
             "]"}]}], ",", 
           RowBox[{"List", "/@", 
            RowBox[{"RandomReal", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{".5", ",", "2"}], "}"}], ",", "trials"}], "]"}]}]}], 
          "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"results", "=", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"NMaximize", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"objFun", "[", 
              RowBox[{
              "\[Alpha]", ",", "a", ",", "q0", ",", "q1", ",", "q2", ",", 
               "\[Eta]", ",", "n", ",", "fun"}], "]"}], ",", 
             RowBox[{"q0", ">", 
              RowBox[{"N", "[", 
               RowBox[{"10", "^", 
                RowBox[{"-", "8"}]}], "]"}]}], ",", 
             RowBox[{"q1", ">", 
              RowBox[{"N", "[", 
               RowBox[{"10", "^", 
                RowBox[{"-", "8"}]}], "]"}]}], ",", 
             RowBox[{"q2", ">", 
              RowBox[{"N", "[", 
               RowBox[{"10", "^", 
                RowBox[{"-", "8"}]}], "]"}]}], ",", 
             RowBox[{
              RowBox[{"q0", "+", "q1", "+", "q2"}], "<", 
              RowBox[{"N", "[", 
               RowBox[{"1", "-", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "8"}]}]}], "]"}]}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"fun", "===", "bYEC"}], ",", 
               RowBox[{"1.999", ">", "a", ">", "1.00001"}], ",", 
               RowBox[{"a", ">", "1.00001"}]}], "]"}], ",", 
             RowBox[{"\[Alpha]", ">", 
              RowBox[{"10", "^", 
               RowBox[{"-", "6"}]}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"q0", ",", "q1", ",", "q2", ",", "a", ",", "\[Alpha]"}], 
            "}"}], ",", 
           RowBox[{"Method", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<NelderMead\>\"", ",", 
              RowBox[{"\"\<InitialPoints\>\"", "->", 
               RowBox[{"{", "seed", "}"}]}]}], "}"}]}], ",", 
           RowBox[{"MaxIterations", "\[Rule]", "500"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"seed", ",", "seeds"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"best", "=", 
       RowBox[{"First", "@", 
        RowBox[{"MaximalBy", "[", 
         RowBox[{"results", ",", "First"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"best", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"q0", ",", "q1", ",", "q2", ",", "a", ",", "\[Alpha]"}], 
          "}"}], " ", "/.", 
         RowBox[{"best", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
