Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Hvon", "=", 
    RowBox[{"Compile", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"valsYE", ",", "_Complex", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"vecsYE", ",", "_Complex", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"valsE", ",", "_Complex", ",", "1"}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rhoYE", ",", "vYE", ",", "logrhoYE"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"vYE", "=", 
          RowBox[{"Transpose", "[", "vecsYE", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"rhoYE", "=", 
          RowBox[{"vYE", ".", 
           RowBox[{"diag16C", "[", "valsYE", "]"}], ".", 
           RowBox[{"Inverse", "[", "vYE", "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"logrhoYE", "=", 
          RowBox[{"vYE", ".", 
           RowBox[{"diag16C", "[", 
            RowBox[{"Log", "[", "valsYE", "]"}], "]"}], ".", 
           RowBox[{"Inverse", "[", "vYE", "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Tr", "[", 
              RowBox[{"rhoYE", ".", "logrhoYE"}], "]"}]}], "+", 
            RowBox[{"Total", "[", 
             RowBox[{"valsE", " ", 
              RowBox[{"Log", "[", "valsE", "]"}]}], "]"}]}], ")"}], "/", 
          RowBox[{"Log", "[", "2", "]"}]}]}]}], "\[IndentingNewLine]", "]"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{"CompilationTarget", "->", "\"\<C\>\""}], ",", 
      RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AEPFast", "[", 
    RowBox[{
     RowBox[{"\[Alpha]_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Eta]_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "rhoE", ",", "rhoYE", ",", "valsYE", ",", "vecsYE", ",", "valsE"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rhoE", "=", 
       RowBox[{"rhoECompiled", "[", 
        RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rhoYE", "=", 
       RowBox[{
        RowBox[{"rhoYECompiledRe", "[", 
         RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}], "+", 
        RowBox[{"I", " ", 
         RowBox[{"rhoYECompiledIm", "[", 
          RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"valsYE", ",", "vecsYE"}], "}"}], "=", 
       RowBox[{"Eigensystem", "[", "rhoYE", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"valsE", "=", 
       RowBox[{"Eigenvalues", "[", "rhoE", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Hvon", "[", 
       RowBox[{"valsYE", ",", "vecsYE", ",", "valsE"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"objFunAEP", "[", 
    RowBox[{
     RowBox[{"\[Alpha]_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Eta]_", "?", "NumericQ"}], ",", 
     RowBox[{"n_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"val", ",", 
       RowBox[{"safe", "=", "True"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"\[Alpha]", "<=", 
         RowBox[{"10", "^", 
          RowBox[{"-", "6"}]}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"-", "penalty"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
       RowBox[{"Check", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"val", "=", 
           RowBox[{
            RowBox[{"AEPFast", "[", 
             RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}], "-", 
            RowBox[{"8", 
             SqrtBox[
              RowBox[{
               RowBox[{"Log2", "[", 
                FractionBox["2", 
                 SuperscriptBox["10", 
                  RowBox[{"-", "8"}]]], "]"}], "/", "n"}]]}], " ", "-", 
            RowBox[{"compiledLeak", "[", 
             RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}], "-", 
            FractionBox[
             RowBox[{
              RowBox[{"Log2", "[", 
               RowBox[{"1", "/", 
                RowBox[{"10.", "^", 
                 RowBox[{"(", 
                  RowBox[{"-", "8"}], ")"}]}]}], "]"}], "-", "1"}], "n"]}]}], 
          ";", 
          RowBox[{"(*", 
           RowBox[{"\[Epsilon]", "=", 
            SuperscriptBox["10", 
             RowBox[{"-", "4"}]]}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"val", "=", 
           RowBox[{"Chop", "@", 
            RowBox[{"Re", "@", "val"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"NumericQ", "[", "val", "]"}], "&&", 
             RowBox[{"FreeQ", "[", 
              RowBox[{"val", ",", 
               RowBox[{
               "ComplexInfinity", "|", "Indeterminate", "|", "Infinity"}]}], 
              "]"}]}], ",", "val", ",", 
            RowBox[{"safe", "=", "False"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"safe", "=", "False"}]}], "]"}], "\[IndentingNewLine]", 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"safe", ",", "val", ",", 
        RowBox[{"-", "penalty"}]}], "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"RateAEP", "[", 
   RowBox[{
    RowBox[{"\[Eta]_", "?", "NumericQ"}], ",", 
    RowBox[{"n_", "?", "NumericQ"}], ",", 
    RowBox[{"nStart_Integer", ":", "6"}]}], "]"}], ":=", 
  RowBox[{"NMaximize", "[", 
