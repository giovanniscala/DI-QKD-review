          RowBox[{"shiftedBlock", "[", 
           RowBox[{"[", "4", "]"}], "]"}], ",", "3"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "shiftedBlock"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"AddRoundKey", " ", "operation", " ", 
