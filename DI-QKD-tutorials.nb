Cell[CellGroupData[{

Cell["Matrix-Based One-Time Pad", "Subsubsection",
 CellChangeTimes->{
  3.9310853893701944`*^9},ExpressionUUID->"7b2a2b4d-bdcf-41dd-bbe7-\
931c69ce5028"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "convert", " ", "a", " ", "character", " ", 
    "to", " ", "its", " ", "numerical", " ", "ASCII", " ", "value"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"charToNumber", "[", "char_", "]"}], ":=", 
    RowBox[{
     RowBox[{"ToCharacterCode", "[", "char", "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "convert", " ", "a", " ", "numerical", " ", 
     "ASCII", " ", "value", " ", "to", " ", "its", " ", "corresponding", " ", 
     "character"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numberToChar", "[", "number_", "]"}], ":=", 
    RowBox[{"FromCharacterCode", "[", "number", "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "pad", " ", "the", " ", "plaintext", " ", 
     "to", " ", "make", " ", "its", " ", "length", " ", "a", " ", "multiple", 
     " ", "of", " ", "the", " ", "block", " ", "size"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"padPlaintext", "[", 
     RowBox[{"plaintext_", ",", "blockSize_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"paddingLength", ",", "paddingChar"}], "}"}], ",", 
      RowBox[{
       RowBox[{"paddingLength", "=", 
        RowBox[{"blockSize", "-", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"StringLength", "[", "plaintext", "]"}], ",", 
           "blockSize"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"paddingLength", "==", "blockSize"}], ",", 
         RowBox[{"paddingLength", "=", "0"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"paddingChar", "=", 
        RowBox[{"FromCharacterCode", "[", "blockSize", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"StringJoin", "[", 
        RowBox[{"plaintext", ",", 
         RowBox[{"StringRepeat", "[", 
          RowBox[{"paddingChar", ",", "paddingLength"}], "]"}]}], "]"}]}]}], 
     "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "generate", " ", "a", " ", "random", " ", 
     "invertible", " ", "key", " ", "matrix", " ", "for", " ", "encryption"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"generateInvertibleKeyMatrix", "[", "blockSize_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"matrix", ",", "det"}], "}"}], ",", 
      RowBox[{
       RowBox[{"While", "[", 
        RowBox[{"True", ",", 
         RowBox[{
          RowBox[{"matrix", "=", 
           RowBox[{"RandomInteger", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "255"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"blockSize", ",", "blockSize"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"det", "=", 
           RowBox[{"Det", "[", 
            RowBox[{"matrix", ",", 
             RowBox[{"Modulus", "->", "256"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"det", "!=", "0"}], "&&", 
             RowBox[{
              RowBox[{"GCD", "[", 
               RowBox[{"det", ",", "256"}], "]"}], "==", "1"}]}], ",", 
            RowBox[{"Break", "[", "]"}]}], "]"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", "matrix"}]}], "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "convert", " ", "a", " ", "string", " ", "to",
      " ", "a", " ", "list", " ", "of", " ", "blocks", " ", "of", " ", 
     "numerical", " ", "values"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"stringToBlocks", "[", 
     RowBox[{"plaintext_", ",", "blockSize_"}], "]"}], ":=", 
    RowBox[{"Partition", "[", 
     RowBox[{
      RowBox[{"charToNumber", "/@", 
       RowBox[{"Characters", "[", "plaintext", "]"}]}], ",", "blockSize"}], 
     "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "convert", " ", "a", " ", "list", " ", "of", 
     " ", "blocks", " ", "of", " ", "numerical", " ", "values", " ", "to", 
     " ", "a", " ", "string"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"blocksToString", "[", "blocks_", "]"}], ":=", 
    RowBox[{"StringJoin", "[", 
     RowBox[{"numberToChar", "/@", 
      RowBox[{"Flatten", "[", "blocks", "]"}]}], "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "encrypt", " ", "a", " ", "block", " ", 
     "using", " ", "a", " ", "key", " ", "matrix"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"encryptBlock", "[", 
     RowBox[{"block_", ",", "keyMatrix_"}], "]"}], ":=", 
    RowBox[{"Mod", "[", 
     RowBox[{
      RowBox[{"keyMatrix", ".", "block"}], ",", "256"}], "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "decrypt", " ", "a", " ", "block", " ", 
     "using", " ", "a", " ", "key", " ", "matrix"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"decryptBlock", "[", 
     RowBox[{"block_", ",", "keyMatrix_"}], "]"}], ":=", 
    RowBox[{"Mod", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Inverse", "[", 
        RowBox[{"keyMatrix", ",", 
         RowBox[{"Modulus", "->", "256"}]}], "]"}], ".", "block"}], ",", 
      "256"}], "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Example", " ", "usage"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plaintext", "=", "\"\<HELLO WORLD\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"blockSize", "=", "4"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Pad", " ", "plaintext"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"paddedPlaintext", "=", 
     RowBox[{"padPlaintext", "[", 
      RowBox[{"plaintext", ",", "blockSize"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "invertible", " ", "key", " ", "matrix"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"keyMatrix", "=", 
     RowBox[{"generateInvertibleKeyMatrix", "[", "blockSize", "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Convert", " ", "plaintext", " ", "to", " ", "blocks"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plaintextBlocks", "=", 
     RowBox[{"stringToBlocks", "[", 
      RowBox[{"paddedPlaintext", ",", "blockSize"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Encrypt", " ", "plaintext", " ", "blocks"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ciphertextBlocks", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"encryptBlock", "[", 
        RowBox[{"#", ",", "keyMatrix"}], "]"}], "&"}], "/@", 
      "plaintextBlocks"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Convert", " ", "ciphertext", " ", "blocks", " ", "to", " ", "string"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ciphertext", "=", 
     RowBox[{"blocksToString", "[", "ciphertextBlocks", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Decrypt", " ", "ciphertext", " ", "blocks"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"decryptedBlocks", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"decryptBlock", "[", 
        RowBox[{"#", ",", "keyMatrix"}], "]"}], "&"}], "/@", 
      "ciphertextBlocks"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Convert", " ", "decrypted", " ", "blocks", " ", "to", " ", "string"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"decryptedText", "=", 
     RowBox[{"blocksToString", "[", "decryptedBlocks", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Remove", " ", "padding", " ", "from", " ", "decrypted", " ", "text"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"decryptedText", "=", 
    RowBox[{"StringTrim", "[", 
     RowBox[{"decryptedText", ",", 
      RowBox[{"FromCharacterCode", "[", "blockSize", "]"}]}], "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Output", " ", "results"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
    "plaintext", ",", "paddedPlaintext", ",", "ciphertext", ",", 
     "decryptedText"}], "}"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.9310854780771613`*^9, 3.9310854909173317`*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"70f4b01e-d789-401c-b92f-f2c889fa2ab3"],

Cell[BoxData["\<\"HELLO WORLD\"\>"], "Output",
