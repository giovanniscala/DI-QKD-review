       "\[IndentingNewLine]", "shiftedBlock"}]}], "\[IndentingNewLine]", 
     "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Inverse", " ", "ShiftRows", " ", "operation"}], "*)"}], "\n", 
