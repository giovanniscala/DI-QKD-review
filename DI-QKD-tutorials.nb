  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "the", " ", "parameter", " ", "p", " ", "appears", " ", "in", " ", 
      SubscriptBox["\[Rho]", "W"]}], "=", 
     RowBox[{
      SubscriptBox["pP", "+"], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "p"}], ")"}], 
       FractionBox["1", "2"]}]}]}], ",", " ", 
    RowBox[{
     RowBox[{
     "therefore", " ", "to", " ", "be", " ", "compare", " ", "with", " ", 
      "the", " ", "disturbance", " ", "d", " ", "we", " ", "use", " ", "d"}], 
     "=", 
     RowBox[{"1", "-", "p"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"rNPJ06", "[", "p_", "]"}], ":=", 
