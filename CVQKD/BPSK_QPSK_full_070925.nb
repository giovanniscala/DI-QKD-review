Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Hminq", "=", 
    RowBox[{"Compile", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
