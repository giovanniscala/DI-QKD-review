        RowBox[{"{", 
         RowBox[{"q0", ",", "_Real"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q1", ",", "_Real"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"q2", ",", "_Real"}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"rhoYE", "=", 
           RowBox[{
            RowBox[{"rhoYECompiledRe", "[", 
             RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}], "+", 
            RowBox[{"I", "*", 
             RowBox[{"rhoYECompiledIm", "[", 
              RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}]}]}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"16", "\[Times]", "16", " ", "complex"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"rho1", "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"0.", "+", 
              RowBox[{"0.", "I"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"16", ",", "16"}], "}"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"16", "\[Times]", "16", " ", "complex"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"rho2", "=", 
           RowBox[{"ConstantArray", "[", 
