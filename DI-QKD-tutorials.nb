   3.9603097051427565`*^9, 3.9603097648121257`*^9}, {3.9603101625162644`*^9, 
   3.960310219248415*^9}, {3.96031051942836*^9, 3.9603106106030197`*^9}, {
   3.9603106519214945`*^9, 3.96031066995543*^9}, {3.9603107080529203`*^9, 
