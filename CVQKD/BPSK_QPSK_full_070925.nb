Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"matPow", "=", 
    RowBox[{"Compile", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"vals", ",", "_Complex", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"vecs", ",", "_Complex", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"p", ",", "_Real"}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"inv", ",", "vecst"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"vecst", "=", 
          RowBox[{"Transpose", "[", "vecs", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"vals", "=", 
            RowBox[{
             RowBox[{"clip\[Lambda]", "[", "vals", "]"}], "^", "p"}]}], ";"}],
           "*)"}], "\[IndentingNewLine]", 
         RowBox[{"inv", "=", 
          RowBox[{"Inverse", "[", "vecst", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"vecst", ".", 
          RowBox[{"DiagonalMatrix", "[", 
           RowBox[{"vals", "^", "p"}], "]"}], ".", "inv"}]}]}], 
       "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"CompilationTarget", "->", "\"\<C\>\""}], ",", 
      RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"diagRe", "=", 
   RowBox[{"Compile", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"v", ",", "_Real", ",", "1"}], "}"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Length", "[", "v", "]"}], ",", 
              RowBox[{"Length", "[", "v", "]"}]}], "}"}]}], "]"}]}], ",", "i",
          ",", "n"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "v", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "<=", "n"}], ",", 
          RowBox[{"i", "++"}], ",", 
          RowBox[{
           RowBox[{"d", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "i"}], "]"}], "]"}], "=", 
           RowBox[{"v", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", "d"}]}], "]"}], ",", 
     RowBox[{"CompilationTarget", "->", "\"\<C\>\""}], ",", 
     RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}]}], "]"}]}], 
  ";"}]}], "Input",
