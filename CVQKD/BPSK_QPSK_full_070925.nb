       RowBox[{"safe", "=", "True"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Alpha]", "<=", 
          RowBox[{"10", "^", 
           RowBox[{"-", "6"}]}]}], "||", 
         RowBox[{"q0", "<", "0"}], "||", 
         RowBox[{"q1", "<", "0"}], "||", 
         RowBox[{"q2", "<", "0"}], "||", 
         RowBox[{
          RowBox[{"q0", "+", "q1", "+", "q2"}], ">", "0.9999"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"-", "penalty"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
       RowBox[{"Check", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"val", "=", 
           RowBox[{
            RowBox[{"Hminq", "[", 
             RowBox[{
             "\[Alpha]", ",", "\[Eta]", ",", "q0", ",", "q1", ",", "q2"}], 
             "]"}], "-", 
            RowBox[{"compiledLeak", "[", 
             RowBox[{"\[Alpha]", ",", "\[Eta]"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"val", "=", 
           RowBox[{"Chop", "@", 
            RowBox[{"Re", "@", "val"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"NumericQ", "[", "val", "]"}], "&&", 
             RowBox[{"FreeQ", "[", 
              RowBox[{"val", ",", 
               RowBox[{
               "ComplexInfinity", "|", "Indeterminate", "|", "Infinity"}]}], 
              "]"}]}], ",", "val", ",", 
            RowBox[{"safe", "=", "False"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"safe", "=", "False"}]}], "]"}], "\[IndentingNewLine]", 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"safe", ",", "val", ",", 
        RowBox[{"-", "penalty"}]}], "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RateHminUp", "[", 
    RowBox[{
     RowBox[{"\[Eta]_", "?", "NumericQ"}], ",", 
     RowBox[{"trials_Integer", ":", "6"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"results", ",", "seeds", ",", "obj", ",", "best"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"seeds", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{"Join", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"RandomReal", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0.01", ",", "0.99"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"trials", ",", "3"}], "}"}]}], "]"}], ",", 
           RowBox[{"List", "/@", 
            RowBox[{"RandomReal", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{".5", ",", "2"}], "}"}], ",", "trials"}], "]"}]}]}], 
          "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"results", "=", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"NMaximize", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"objFunHminUp", "[", 
              RowBox[{
              "\[Alpha]", ",", "\[Eta]", ",", "q0", ",", "q1", ",", "q2"}], 
              "]"}], ",", 
             RowBox[{"q0", ">", 
              RowBox[{"N", "[", 
               SuperscriptBox["10", 
                RowBox[{"-", "8"}]], "]"}]}], ",", 
             RowBox[{"q1", ">", 
              RowBox[{"N", "[", 
               SuperscriptBox["10", 
                RowBox[{"-", "8"}]], "]"}]}], ",", 
             RowBox[{"q2", ">", 
              RowBox[{"N", "[", 
               SuperscriptBox["10", 
                RowBox[{"-", "8"}]], "]"}]}], ",", 
             RowBox[{
              RowBox[{"N", "[", 
               RowBox[{"1", "-", 
                SuperscriptBox["10", 
                 RowBox[{"-", "8"}]]}], "]"}], ">", 
              RowBox[{"q0", "+", "q1", "+", "q2"}]}], ",", 
             RowBox[{"\[Alpha]", ">", "0.0001"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"q0", ",", "q1", ",", "q2", ",", "\[Alpha]"}], "}"}], ",", 
           RowBox[{"Method", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<NelderMead\>\"", ",", 
              RowBox[{"\"\<InitialPoints\>\"", "->", 
               RowBox[{"{", "seed", "}"}]}]}], "}"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"seed", ",", "seeds"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"best", "=", 
       RowBox[{"First", "@", 
        RowBox[{"MaximalBy", "[", 
         RowBox[{"results", ",", "First"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", "best"}]}], "]"}]}], ";"}]}], "Input",
